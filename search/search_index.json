{"config":{"lang":["ko","en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u2163. \uc778\uacf5\uc9c0\ub2a5","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uac1c\ub150\uacfc \ud2b9\uc131\uc744 \uc774\ud574\ud558\uace0, \uc778\uacf5\uc9c0\ub2a5 \ubc1c\uc804\uc5d0 \ub530\ub978 \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud558\ub294 1\ucc28\uc2dc 50\ubd84 \ud63c\ud569\ud615 \uc778\ud130\ub799\ud2f0\ube0c \uc218\uc5c5 \uad50\uc7ac\uc785\ub2c8\ub2e4. \uc774\ub860 \uc124\uba85\uacfc \uc911\uac04 \ud65c\ub3d9\uc774 \uacb0\ud569\ub41c \ud63c\ud569\ud615 \uad6c\uc131\uc73c\ub85c, \ud559\uc0dd\uc774 \uc9c1\uc811 \ucc44\uc6b0\uace0 \uc815\ub9ac\ud558\ub294 \ucc38\uc5ec\ud615 \ud65c\ub3d9\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4.</p>"},{"location":"#_1","title":"\ubaa9\ucc28","text":""},{"location":"#part-1-01","title":"Part 1: 01. \uc778\uacf5\uc9c0\ub2a5\uacfc \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8","text":"<ul> <li>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc640 \uc778\uac04\uc758 \uc5ed\ud560 \ud0d0\uc0c9</li> </ul> <p>\uac15\uc815\ud76c \u00b7 \uad11\uc8fc\ub3d9\uc2e0\uc5ec\uc790\uace0\ub4f1\ud559\uad50 \u00b7 2026-03-30 \u00b7 \uac80\ud1a0: (\ubbf8\uc9c0\uc815)</p> <p>EduFlow</p>"},{"location":"chapter01/","title":"\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc640 \uc778\uac04\uc758 \uc5ed\ud560 \ud0d0\uc0c9","text":""},{"location":"chapter01/#part-1","title":"\ud83d\udcd8 Part 1: \uc778\uacf5\uc9c0\ub2a5\uacfc \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8","text":"<p>\"\uae30\uacc4\uac00 \uc0dd\uac01\ud560 \uc218 \uc788\uc744\uae4c?\" \u2014 \uc568\ub7f0 \ud29c\ub9c1, 1950</p> <p>\uc774 \uc9c8\ubb38 \ud558\ub098\uac00 \uc624\ub298\ub0a0 \uc778\uacf5\uc9c0\ub2a5\uc758 \uc2dc\ub300\ub97c \uc5f4\uc5c8\uc2b5\ub2c8\ub2e4.  \uc774\uc81c \uc6b0\ub9ac\ub294 \uadf8 \uc9c8\ubb38\uc5d0 \ub2f5\ud558\ub294 \uc2dc\ub300\uc5d0 \uc0b4\uace0 \uc788\uc2b5\ub2c8\ub2e4. </p>"},{"location":"chapter01/#_1","title":"\ud83c\udfaf \ud559\uc2b5 \ubaa9\ud45c","text":"<ul> <li>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uac1c\ub150\uacfc \ud2b9\uc131\uc744 \uc124\uba85\ud560 \uc218 \uc788\ub2e4.</li> <li>\uc778\uacf5\uc9c0\ub2a5 \ubc1c\uc804\uc5d0 \ub530\ub978 \uc778\uac04\uacfc \uc778\uacf5\uc9c0\ub2a5\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud560 \uc218 \uc788\ub2e4.</li> </ul>   \ud83c\udfaf \ud575\uc2ec \uc8fc\uc81c 1: \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub780 \ubb34\uc5c7\uc778\uac00?        \ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0 \ud310\ub2e8\ud558\uc5ec \ud589\ub3d9\ud558\ub294 \uc790\uc728\uc801 \uc2dc\uc2a4\ud15c\uc758 \uac1c\ub150\uacfc \ud2b9\uc131\uc744 \ubc30\uc6c1\ub2c8\ub2e4.     \ud83c\udfaf \ud575\uc2ec \uc8fc\uc81c 2: \uc778\uacf5\uc9c0\ub2a5\uc758 \ubc1c\uc804\uacfc \uc778\uac04\uc758 \uc5ed\ud560?           \uc778\uacf5\uc9c0\ub2a5\uc774 \ubc1c\uc804\ud558\uba74\uc11c \uc778\uac04\uc774 \ud574\uc57c \ud560 \uace0\uc720\ud55c \uc5ed\ud560\uc774 \ubb34\uc5c7\uc778\uc9c0 \ud0d0\uc0c9\ud569\ub2c8\ub2e4."},{"location":"chapter01/#_2","title":"\u23f1\ufe0f \uc218\uc5c5 \ud750\ub984","text":"\ub3c4\uc785 (5\ubd84)      **\ud29c\ub9c1 \ud14c\uc2a4\ud2b8: \uae30\uacc4\ub294 \uc0dd\uac01\ud560 \uc218 \uc788\ub294\uac00?**     \uc5ed\uc0ac\uc801 \ub9e5\ub77d\uc5d0\uc11c \uc778\uacf5\uc9c0\ub2a5\uc744 \ubc14\ub77c\ubcf4\uba70 \ud765\ubbf8\ub97c \uc720\ubc1c\ud569\ub2c8\ub2e4.           \uc804\uac1c 1~2 (15\ubd84)    **\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uac1c\ub150\uacfc \ud2b9\uc131**     \ube44\uc720 \u2192 \uc815\uc758 \u2192 \uc608\uc2dc\uc758 3\ub2e8\uacc4\ub85c \ud575\uc2ec \uac1c\ub150\uc744 \ud559\uc2b5\ud569\ub2c8\ub2e4.              \uc804\uac1c 3~4 (15\ubd84) **\uc2e4\uc0dd\ud65c \uc0ac\ub840 \ubd84\ub958 \ud65c\ub3d9**     \uc2e4\uc81c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \uc0ac\ub840\ub97c \ubd84\uc11d\ud558\uace0 \ud45c\ub97c \uc9c1\uc811 \uc644\uc131\ud569\ub2c8\ub2e4.           \uc804\uac1c 5~6 (10\ubd84)       **AI\uc758 \uc21c\uae30\ub2a5\u00b7\uc5ed\uae30\ub2a5\uacfc \uc778\uac04\uc758 \uace0\uc720 \uc5ed\ud560**     \uc778\uacf5\uc9c0\ub2a5\uc774 \uc798\ud558\ub294 \uac83\uacfc \uc778\uac04\uc774 \ud574\uc57c \ud558\ub294 \uac83\uc744 \ube44\uad50\ud569\ub2c8\ub2e4.           \uc815\ub9ac (5\ubd84)    **\ub9c8\uc778\ub4dc\ub9f5 \uc644\uc131 &amp; \uc790\uae30 \uc810\uac80**     \ud575\uc2ec \ub0b4\uc6a9\uc744 \ub9c8\uc778\ub4dc\ub9f5\uc73c\ub85c \uc815\ub9ac\ud558\uace0 \ud034\uc988\ub85c \ud655\uc778\ud569\ub2c8\ub2e4."},{"location":"chapter01/#_3","title":"\uc65c \uc774\uac78 \ubc30\uc6b0\ub098\uc694?","text":"<p>\uc5ec\ub7ec\ubd84\uc758 \uc2a4\ub9c8\ud2b8\ud3f0 \uc18d AI \ube44\uc11c\ub294 \uc5b4\ub5bb\uac8c \uc5ec\ub7ec\ubd84\uc758 \ub9d0\uc744 \uc54c\uc544\ub4e4\uc744\uae4c\uc694?  \ub85c\ubd07 \uccad\uc18c\uae30\ub294 \uc5b4\ub5bb\uac8c \ubc29 \uc548\uc744 \ud63c\uc790\uc11c \uccad\uc18c\ud560\uae4c\uc694?  \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\ub294 \uc5b4\ub5bb\uac8c \uc0ac\ub78c \uc5c6\uc774 \uc6b4\uc804\ud560 \uc218 \uc788\uc744\uae4c\uc694?</p> <p>\uc774 \ubaa8\ub4e0 \uac83\ub4e4\uc758 \ud575\uc2ec\uc5d0\ub294 '\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8' \ub77c\ub294 \uac1c\ub150\uc774 \uc788\uc2b5\ub2c8\ub2e4.  \uc624\ub298\ub0a0 \uc778\uacf5\uc9c0\ub2a5\uc774 \uc6b0\ub9ac \uc0b6 \uacf3\uacf3\uc5d0 \ud30c\uace0\ub4dc\ub294 \uc9c0\uae08, \uc774 \uac1c\ub150\uc744 \uc774\ud574\ud558\ub294 \uac83\uc740 \ub2e8\uc21c\ud55c \uae30\uc220 \uc9c0\uc2dd\uc774 \uc544\ub2d9\ub2c8\ub2e4.  \ubbf8\ub798 \uc0ac\ud68c\uc5d0\uc11c \uc778\uac04\uc73c\ub85c\uc11c \uc5b4\ub5a4 \uc5ed\ud560\uc744 \ud574\uc57c \ud560\uc9c0\ub97c \uace0\ubbfc\ud558\ub294 \ucd9c\ubc1c\uc810\uc774 \ub429\ub2c8\ub2e4.</p> <p>\uc778\uacf5\uc9c0\ub2a5\uc774 \ub300\uc2e0\ud560 \uc218 \uc788\ub294 \uc77c\uacfc \uc778\uac04\ub9cc\uc774 \ud560 \uc218 \uc788\ub294 \uc77c\uc744 \uad6c\ubd84\ud558\uace0, \uadf8 \uc0ac\uc774\uc5d0\uc11c \ud604\uba85\ud558\uac8c \ud611\ub825\ud558\ub294 \ubc29\ubc95\uc744 \ud568\uaed8 \ud0d0\uc0c9\ud574 \ubd05\uc2dc\ub2e4. </p>"},{"location":"chapter01/#_4","title":"\u2705 \ub3c4\uc785: \ud29c\ub9c1 \ud14c\uc2a4\ud2b8\uc640 \uc778\uacf5\uc9c0\ub2a5\uc758 \uc2dc\uc791","text":"\uc568\ub7f0 \ud29c\ub9c1 (Alan Turing, 1912~1954)     \uc601\uad6d\uc758 \uc218\ud559\uc790\uc774\uc790 \ucef4\ud4e8\ud130 \uacfc\ud559\uc758 \uc544\ubc84\uc9c0.     \uc81c2\ucc28 \uc138\uacc4 \ub300\uc804 \ub2f9\uc2dc \ub3c5\uc77c\uad70\uc758 \uc554\ud638(\uc5d0\ub2c8\uadf8\ub9c8)\ub97c \ud574\ub3c5\ud558\ub294 \uae30\uacc4\ub97c \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4.     1950\ub144, \uadf8\ub294 \ub17c\ubb38 \u300c\ucef4\ud4e8\ud305 \uae30\uacc4\uc640 \uc9c0\ub2a5\u300d\uc5d0\uc11c \uc5ed\uc0ac\uc801\uc778 \uc9c8\ubb38\uc744 \ub358\uc84c\uc2b5\ub2c8\ub2e4.      **\"\uae30\uacc4\uac00 \uc0dd\uac01\ud560 \uc218 \uc788\ub294\uac00?(Can machines think?)\"**           \ud29c\ub9c1 \ud14c\uc2a4\ud2b8 (Turing Test)          **\uc9c8\ubb38**: \uae30\uacc4\uac00 \uc0ac\ub78c\uacfc \uad6c\ubcc4\ud560 \uc218 \uc5c6\uc744 \ub9cc\ud07c \uc9c0\ub2a5\uc801\uc73c\ub85c \ud589\ub3d9\ud560 \uc218 \uc788\ub2e4\uba74, \uadf8 \uae30\uacc4\ub97c \uc9c0\ub2a5\uc774 \uc788\ub2e4\uace0 \ubcfc \uc218 \uc788\uc9c0 \uc54a\uc744\uae4c?           **\uc2e4\ud5d8 \ubc29\ubc95**: \uc2ec\uc0ac\uad00\uc774 \ud654\uba74 \ub108\uba38 \ub300\ud654 \uc0c1\ub300\uac00 \uc0ac\ub78c\uc778\uc9c0 \uae30\uacc4\uc778\uc9c0 \uad6c\ubd84\ud560 \uc218 \uc5c6\ub2e4\uba74, \uadf8 \uae30\uacc4\ub294 '\uc9c0\ub2a5\uc774 \uc788\ub2e4'\uace0 \ud310\ub2e8\ud569\ub2c8\ub2e4.         <p>\ud29c\ub9c1 \ud14c\uc2a4\ud2b8\ub294 \uc778\uacf5\uc9c0\ub2a5\uc774 \ubb34\uc5c7\uc778\uc9c0\ub97c \uc815\uc758\ud558\ub294 \uccab \ubc88\uc9f8 \uc2dc\ub3c4\uc600\uc2b5\ub2c8\ub2e4. \ube44\ub85d \"\uae30\uacc4\uac00 \uc2e4\uc81c\ub85c '\uc0dd\uac01'\ud558\ub294\uc9c0\"\uc5d0 \ub300\ud55c \ucca0\ud559\uc801 \ub17c\uc7c1\uc740 \uc5ec\uc804\ud788 \uacc4\uc18d\ub418\uc9c0\ub9cc, \uc774 \ud14c\uc2a4\ud2b8\ub294 \uc778\uacf5\uc9c0\ub2a5 \uc5f0\uad6c\uc758 \uc5ed\uc0ac\uc801 \ucd9c\ubc1c\uc810\uc774 \ub418\uc5c8\uc2b5\ub2c8\ub2e4.   </p> timeline     title \uc778\uacf5\uc9c0\ub2a5\uc758 \uc5ed\uc0ac\uc801 \ud750\ub984     1950 : \uc568\ub7f0 \ud29c\ub9c1, \ud29c\ub9c1 \ud14c\uc2a4\ud2b8 \uc81c\uc548          : \"\uae30\uacc4\uac00 \uc0dd\uac01\ud560 \uc218 \uc788\ub294\uac00?\"     1956 : \ub2e4\ud2b8\uba38\uc2a4 \ud68c\uc758\uc5d0\uc11c          : \"\uc778\uacf5\uc9c0\ub2a5(AI)\" \uc6a9\uc5b4 \ucc98\uc74c \ub4f1\uc7a5     1997 : IBM \ub525\ube14\ub8e8, \uccb4\uc2a4 \uc138\uacc4\ucc54\ud53c\uc5b8          : \uac00\ub9ac \uce74\uc2a4\ud30c\ub85c\ud504\ub97c \uc774\uae40     2011 : IBM \uc653\uc2a8, \ud034\uc988\uc1fc \uc81c\ud37c\ub514!          : \uc778\uac04 \ucc54\ud53c\uc5b8\uc744 \uaebe\uc74c     2016 : \uad6c\uae00 \uc54c\ud30c\uace0, \ubc14\ub451          : \uc774\uc138\ub3cc 9\ub2e8\uc744 4\ub3001\ub85c \uc774\uae40     2022 : ChatGPT \ub4f1\uc7a5          : \ub300\ud654\ud615 AI\uc758 \ub300\uc911\ud654 \uc2dc\ub300 \uac1c\ub9c9 <p>\uc704 \ud0c0\uc784\ub77c\uc778\uc740 \uc778\uacf5\uc9c0\ub2a5\uc774 \uc5b4\ub5bb\uac8c \ubc1c\uc804\ud574 \uc654\ub294\uc9c0\ub97c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. 1950\ub144 \ud558\ub098\uc758 \uc9c8\ubb38\uc5d0\uc11c \uc2dc\uc791\ud55c \uc778\uacf5\uc9c0\ub2a5\uc774 \uc624\ub298\ub0a0 \uc6b0\ub9ac\uc758 \uc77c\uc0c1 \uc18d\uc5d0 \ub4e4\uc5b4\uc624\uae30\uae4c\uc9c0 \uac78\ub9b0 \uc2dc\uac04\uc740 \ubd88\uacfc 70\uc5ec \ub144\uc785\ub2c8\ub2e4.</p>"},{"location":"chapter01/#1","title":"\ud83d\udcda \ud575\uc2ec \uac1c\ub150 1: \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8?","text":""},{"location":"chapter01/#1_1","title":"1\ufe0f\u20e3 \uc2dc\uc791\ud558\uae30","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \ub9c8\uce58 '\ub9e1\uaca8\uc9c4 \uc77c\uc744 \uc54c\uc544\uc11c \ucc98\ub9ac\ud558\ub294 \ub611\ub611\ud55c \uc9c1\uc6d0'\uacfc \uac19\uc2b5\ub2c8\ub2e4. </p> <p>\uc5ec\ub7ec\ubd84\uc774 \ud68c\uc0ac \uc0ac\uc7a5\uc774\uace0, \uc544\uc8fc \uc720\ub2a5\ud55c \uc9c1\uc6d0\uc744 \ud55c \uba85 \ubf51\uc558\ub2e4\uace0 \uc0c1\uc0c1\ud574 \ubcf4\uc138\uc694. \uc774 \uc9c1\uc6d0\uc740:</p> <ol> <li>\uc8fc\ubcc0 \uc0c1\ud669\uc744 \uc2a4\uc2a4\ub85c \ud30c\uc545\ud558\uace0 (\uc778\uc2dd)</li> <li>\"\uc774 \uc0c1\ud669\uc5d0\uc11c \uc5b4\ub5bb\uac8c \ud574\uc57c \ucd5c\uc120\uc77c\uae4c?\"\ub97c \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uace0 (\ud310\ub2e8)</li> <li>\uc0ac\uc7a5\uc774 \uc77c\uc77c\uc774 \uc9c0\uc2dc\ud558\uc9c0 \uc54a\uc544\ub3c4 \uc2a4\uc2a4\ub85c \ud589\ub3d9\ud569\ub2c8\ub2e4. (\ud589\ub3d9)</li> </ol> <p>\uc774\uac83\uc774 \ubc14\ub85c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8(Intelligent Agent) \uc785\ub2c8\ub2e4!</p>"},{"location":"chapter01/#2","title":"2\ufe0f\u20e3 \uac1c\ub150\uc815\uc758","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8(Intelligent Agent):  \ud658\uacbd(Environment)\uc73c\ub85c\ubd80\ud130 \uc815\ubcf4\ub97c \uc778\uc2dd(Perceive) \ud558\uace0,  \uadf8 \uc815\ubcf4\ub97c \ubc14\ud0d5\uc73c\ub85c \ud310\ub2e8(Decide) \ud558\uc5ec,  \ubaa9\ud45c(Goal)\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud574 \ud589\ub3d9(Act) \ud558\ub294 \uc790\uc728\uc801\uc778 \uc2dc\uc2a4\ud15c</p> <p>\uc5ec\uae30\uc11c \uc911\uc694\ud55c \ub2e8\uc5b4\ub294 '\uc790\uc728\uc801(Autonomous)' \uc785\ub2c8\ub2e4.  \uc790\uc728\uc801\uc774\ub77c\ub294 \uac83\uc740 \uc0ac\ub78c\uc774 \ub9e4\ubc88 \uc9c0\uc2dc\ud558\uc9c0 \uc54a\uc544\ub3c4 \uc2a4\uc2a4\ub85c \uc791\ub3d9\ud55c\ub2e4\ub294 \uc758\ubbf8\uc785\ub2c8\ub2e4.</p> <p>\uc778\uacf5\uc9c0\ub2a5 \ubd84\uc57c\uc758 \uad8c\uc704 \uc788\ub294 \uad50\uc7ac\uc778 \u300c\uc778\uacf5\uc9c0\ub2a5: \ud604\ub300\uc801 \uc811\uadfc\u300d(\ub7ec\uc140 &amp; \ub178\ub974\ube45, 2020)\uc5d0\uc11c\ub294 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \ub2e4\uc74c\uacfc \uac19\uc774 \uc815\uc758\ud569\ub2c8\ub2e4.</p> <p>\"\uc5d0\uc774\uc804\ud2b8\ub294 \uc13c\uc11c(sensor)\ub97c \ud1b5\ud574 \ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0, \uc791\ub3d9\uae30(actuator)\ub97c \ud1b5\ud574 \ud658\uacbd\uc5d0 \ud589\ub3d9\ud558\ub294 \ubaa8\ub4e0 \uac83\uc774\ub2e4.\"</p>"},{"location":"chapter01/#3","title":"3\ufe0f\u20e3 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \ud575\uc2ec \uad6c\uc870: \uc778\uc2dd \u2192 \ud310\ub2e8 \u2192 \ud589\ub3d9","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uac00 \uc791\ub3d9\ud558\ub294 \ubc29\uc2dd\uc744 \ub3c4\uc2dd\uc73c\ub85c \ud45c\ud604\ud558\uba74 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.</p> \ud658\uacbd (Environment) \uc13c\uc11c \uc778\uc2dd (Perceive) \ud310\ub2e8 (Decide) \ud589\ub3d9 (Act) \ud53c\ub4dc\ubc31 (\uacb0\uacfc\uac00 \ub2e4\uc2dc \ud658\uacbd\uc5d0 \uc601\ud5a5) <p>\uc124\uba85: \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \ud658\uacbd\uc5d0\uc11c \uc815\ubcf4\ub97c \uc778\uc2dd\ud558\uace0, \ud310\ub2e8\ud558\uc5ec \ud589\ub3d9\ud569\ub2c8\ub2e4. \ud589\ub3d9\uc758 \uacb0\uacfc\ub294 \ub2e4\uc2dc \ud658\uacbd\uc5d0 \uc601\ud5a5\uc744 \uc8fc\uc5b4 \uc0c8\ub85c\uc6b4 \uc778\uc2dd\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294 \uc21c\ud658 \uad6c\uc870\ub97c \uac00\uc9d1\ub2c8\ub2e4.</p>"},{"location":"chapter01/#4","title":"4\ufe0f\u20e3 \uc608\uc2dc: \ub85c\ubd07 \uccad\uc18c\uae30\uc640 \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28","text":"<p>**\uc608\uc2dc 1: \ub85c\ubd07 \uccad\uc18c\uae30 **</p> <p>\uc5ec\ub7ec\ubd84 \uc9d1\uc5d0 \uc788\ub294 \ub85c\ubd07 \uccad\uc18c\uae30\ub97c \uc0dd\uac01\ud574 \ubd05\uc2dc\ub2e4.</p> \ub2e8\uacc4 \ub85c\ubd07 \uccad\uc18c\uae30\uac00 \ud558\ub294 \uc77c \uc0ac\uc6a9\ud558\ub294 \uae30\uc220 \ud658\uacbd \ubc29 \uc548 (\uac00\uad6c, \uba3c\uc9c0, \ubcbd, \uc0ac\ub78c) - \uc778\uc2dd \uce74\uba54\ub77c\u00b7\uc13c\uc11c\ub85c \uc7a5\uc560\ubb3c\uacfc \uba3c\uc9c0 \uac10\uc9c0 \uadfc\uc811 \uc13c\uc11c, \uce74\uba54\ub77c \ud310\ub2e8 \"\uc67c\ucabd\uc5d0 \uc758\uc790\uac00 \uc788\uc73c\ub2c8 \uc624\ub978\ucabd\uc73c\ub85c \uac00\uc57c\uaca0\ub2e4\" AI \uc54c\uace0\ub9ac\uc998 \ud589\ub3d9 \ubc29\ud5a5\uc744 \ubc14\uafb8\uc5b4 \uccad\uc18c\ub97c \uacc4\uc18d\ud568 \ubc14\ud034 \ubaa8\ud130 \ubaa9\ud45c \ubc29 \uc804\uccb4\ub97c \uae68\ub057\ud558\uac8c \uccad\uc18c\ud558\uae30 - <p>**\uc608\uc2dc 2: \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28 **</p> \ub2e8\uacc4 \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\uac00 \ud558\ub294 \uc77c \uc0ac\uc6a9\ud558\ub294 \uae30\uc220 \ud658\uacbd \ub3c4\ub85c, \uc2e0\ud638\ub4f1, \ubcf4\ud589\uc790, \ub2e4\ub978 \ucc28\ub7c9 - \uc778\uc2dd \uce74\uba54\ub77c\u00b7\ub77c\uc774\ub2e4\ub85c \uc8fc\ubcc0 360\u00b0 \uc2a4\uce94 \ub77c\uc774\ub2e4(LiDAR), \ub808\uc774\ub354 \ud310\ub2e8 \"\uc2e0\ud638\uac00 \ube68\uac04\uc0c9\uc774\ub2c8 \uba48\ucdb0\uc57c \ud55c\ub2e4\" \ub525\ub7ec\ub2dd \ubaa8\ub378 \ud589\ub3d9 \ube0c\ub808\uc774\ud06c\ub97c \ubc1f\uc544 \uc815\uc9c0 \uc561\ucd94\uc5d0\uc774\ud130 \ubaa9\ud45c \ubaa9\uc801\uc9c0\uae4c\uc9c0 \uc548\uc804\ud558\uac8c \uc774\ub3d9 -"},{"location":"chapter01/#5-4","title":"5\ufe0f\u20e3 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 4\uac00\uc9c0 \ud575\uc2ec \ud2b9\uc131","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub2f5\uac8c \ub9cc\ub4dc\ub294 \ud2b9\uc131\uc740 \ubb34\uc5c7\uc77c\uae4c\uc694?</p> flowchart TD     A[\"\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758&lt;br/&gt;\ud575\uc2ec \ud2b9\uc131\"] --&gt; B[\"\uc790\uc728\uc131&lt;br/&gt;(Autonomy)\"]     A --&gt; C[\"\ubc18\uc751\uc131&lt;br/&gt;(Reactivity)\"]     A --&gt; D[\"\ubaa9\ud45c \uc9c0\ud5a5\uc131&lt;br/&gt;(Goal-directedness)\"]     A --&gt; E[\"\uc801\uc751\uc131&lt;br/&gt;(Adaptability)\"]      B --&gt; B1[\"\uc0ac\ub78c\uc758 \uc9c0\uc2dc \uc5c6\uc774&lt;br/&gt;\uc2a4\uc2a4\ub85c \uc791\ub3d9\"]     C --&gt; C1[\"\ud658\uacbd \ubcc0\ud654\uc5d0&lt;br/&gt;\uc989\uac01 \ubc18\uc751\"]     D --&gt; D1[\"\ud2b9\uc815 \ubaa9\ud45c \ub2ec\uc131\uc744&lt;br/&gt;\uc704\ud574 \ud589\ub3d9\"]     E --&gt; E1[\"\uc0c8\ub85c\uc6b4 \uc0c1\ud669\uc5d0&lt;br/&gt;\ub9de\uac8c \ud559\uc2b5\u00b7\uc870\uc815\"] <p>\uc704 \ub2e4\uc774\uc5b4\uadf8\ub7a8\uc740 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 4\uac00\uc9c0 \ud575\uc2ec \ud2b9\uc131\uc744 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.  \uc774 \ub124 \uac00\uc9c0\uac00 \uac16\ucd94\uc5b4\uc838\uc57c \uc9c4\uc815\ud55c \uc758\ubbf8\uc758 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub77c\uace0 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p> \ud2b9\uc131 \uc758\ubbf8 \ub85c\ubd07 \uccad\uc18c\uae30 \uc608\uc2dc \uc790\uc728\uc131 \uc0ac\ub78c\uc774 \ub9e4\ubc88 \uc9c0\uc2dc\ud558\uc9c0 \uc54a\uc544\ub3c4 \uc2a4\uc2a4\ub85c \ub3d9\uc791 \uc2a4\ucf00\uc904 \uc124\uc815\ub9cc \ud558\uba74 \ud63c\uc790 \uccad\uc18c \ubc18\uc751\uc131 \ud658\uacbd \ubcc0\ud654\uc5d0 \uc989\uac01\uc801\uc73c\ub85c \ubc18\uc751 \uace0\uc591\uc774\uac00 \uc55e\uc5d0 \ub098\ud0c0\ub098\uba74 \uba48\ucda4 \ubaa9\ud45c \uc9c0\ud5a5\uc131 \ud2b9\uc815 \ubaa9\ud45c \ub2ec\uc131\uc744 \uc704\ud574 \uc77c\uad00\ub418\uac8c \ud589\ub3d9 \ubc29 \uc804\uccb4\ub97c \uae68\ub057\uc774 \ud558\ub294 \uac83\uc774 \ubaa9\ud45c \uc801\uc751\uc131 \uc0c8\ub85c\uc6b4 \uc0c1\ud669\uc744 \ud559\uc2b5\ud558\uc5ec \ub354 \uc798 \ub300\ucc98 \uc9d1 \uad6c\uc870\ub97c \ud559\uc2b5\ud558\uc5ec \uccad\uc18c \uacbd\ub85c \ucd5c\uc801\ud654"},{"location":"chapter01/#2_1","title":"\ud83d\udcda \ud575\uc2ec \uac1c\ub150 2: \uc778\uacf5\uc9c0\ub2a5\uc758 \ubc1c\uc804\uacfc \uc778\uac04\uc758 \uc5ed\ud560","text":""},{"location":"chapter01/#1_2","title":"1\ufe0f\u20e3 \uc778\uacf5\uc9c0\ub2a5, \uc5bc\ub9c8\ub098 \ube60\ub974\uac8c \ubc1c\uc804\ud588\uc744\uae4c?","text":"<p>\uc778\uacf5\uc9c0\ub2a5\uc774 \ucc98\ub9ac\ud560 \uc218 \uc788\ub294 \ub370\uc774\ud130\uc758 \uc591\uacfc \uc18d\ub3c4\ub294 \uc778\uac04\uacfc \ube44\uad50\uc870\ucc28 \uc5b4\ub824\uc6b4 \uc218\uc900\uc73c\ub85c \uc131\uc7a5\ud588\uc2b5\ub2c8\ub2e4.</p> \uc778\uac04 vs \uc778\uacf5\uc9c0\ub2a5: \ub370\uc774\ud130 \ucc98\ub9ac \ub2a5\ub825 \ube44\uad50   \ub3c5\uc11c \uc18d\ub3c4 \ubd84\ub2f9 \uc57d 200~400 \ub2e8\uc5b4   ... GPT-4: \ucd08\ub2f9 \uc218\ubc31\ub9cc \ud1a0\ud070(\ub2e8\uc5b4) \ucc98\ub9ac \uac00\ub2a5 \uc778\uac04 \uc778\uacf5\uc9c0\ub2a5(AI) \u203b \ub2e8\uc21c \ub370\uc774\ud130 \ucc98\ub9ac \uc18d\ub3c4\uc5d0\uc11c AI\ub294 \uc778\uac04\uc744 \uc555\ub3c4\uc801\uc73c\ub85c \ub2a5\uac00\ud569\ub2c8\ub2e4 <p>\uc774\ucc98\ub7fc \ub370\uc774\ud130 \ucc98\ub9ac \uc18d\ub3c4\uc640 \uc815\ud655\uc131\uc5d0\uc11c \uc778\uacf5\uc9c0\ub2a5\uc740 \uc774\ubbf8 \uc778\uac04\uc744 \ud6e8\uc52c \ub2a5\uac00\ud569\ub2c8\ub2e4.  \uadf8\ub807\ub2e4\uba74 \uc778\uac04\uc740 \uc778\uacf5\uc9c0\ub2a5\uc5d0\uac8c \uc790\ub9ac\ub97c \ube7c\uc557\uae30\ub294 \uac83\uc77c\uae4c\uc694?</p> <p>\uadf8\ub807\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4!  \uc778\uac04\uc5d0\uac8c\ub294 \uc778\uacf5\uc9c0\ub2a5\uc774 \uac16\uc9c0 \ubabb\ud55c \uace0\uc720\ud55c \ub2a5\ub825\uc774 \uc788\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4. </p>"},{"location":"chapter01/#2-ai","title":"2\ufe0f\u20e3 \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560 \u2014 \ubca4 \ub2e4\uc774\uc5b4\uadf8\ub7a8","text":"\ud83e\udde0 \uc778\uac04\ub9cc\uc758 \uc5ed\ud560 \ud83e\udd16 AI\uc758 \uc5ed\ud560 \ud83e\udd1d \ud611\uc5c5 \ud83c\udfa8 \ucc3d\uc758\uc801 \uc0ac\uace0 \u2764\ufe0f \uac10\uc131\uacfc \uacf5\uac10 \ub2a5\ub825 \u2696\ufe0f \uc724\ub9ac\uc801 \ud310\ub2e8 \ud83c\udfaf \ubaa9\ud45c \uc124\uc815 \ud83d\udca1 \uac00\uce58 \ud310\ub2e8 \ud83e\udd1d AI\uc640\uc758 \ud611\uc5c5 \ub2a5\ub825 \ud83d\udcca \ub370\uc774\ud130 \ud65c\uc6a9\u00b7\ud574\uc11d \u26a1 \ube60\ub978 \ub370\uc774\ud130 \ucc98\ub9ac \ud83d\udd04 \ubc18\ubcf5 \uc791\uc5c5 \uc790\ub3d9\ud654 \ud83d\udd0d \ud328\ud134 \uc778\uc2dd \ud83d\udcc8 \uc608\uce21 \ubc0f \ucd94\ucc9c \ud83c\udf10 24\uc2dc\uac04 \uc6b4\uc601 \uc778\uac04\uacfc AI\ub294 \uacbd\uc7c1 \uad00\uacc4\uac00 \uc544\ub2c8\ub77c, \uc11c\ub85c\uc758 \uac15\uc810\uc744 \uc0b4\ub9ac\ub294 \ud611\ub825 \uad00\uacc4\uc785\ub2c8\ub2e4."},{"location":"chapter01/#3_1","title":"3\ufe0f\u20e3 \uadf8\ub807\ub2e4\uba74 \uc6b0\ub9ac\ub294 \ubb34\uc5c7\uc744 \uc900\ube44\ud574\uc57c \ud560\uae4c?","text":"\uc5ed\ub7c9 \uc124\uba85 \uc65c \ud544\uc694\ud55c\uac00? \ud83c\udfa8 \ucc3d\uc758\uc801 \uc0ac\uace0 \uc0c8\ub85c\uc6b4 \uc544\uc774\ub514\uc5b4\ub97c \ub9cc\ub4e4\uace0 \ubb38\uc81c\ub97c \ub3c5\ucc3d\uc801\uc73c\ub85c \ud574\uacb0 AI\ub294 \uae30\uc874 \ub370\uc774\ud130 \uae30\ubc18\uc73c\ub85c\ub9cc \uc0dd\uc131, \uc9c4\uc9dc \uc0c8\ub85c\uc6c0\uc740 \uc778\uac04\uc758 \ubaab \u2764\ufe0f \uac10\uc131\uacfc \uacf5\uac10 \ub2a5\ub825 \ud0c0\uc778\uc758 \uac10\uc815\uc744 \uc774\ud574\ud558\uace0 \uc9c4\uc2ec\uc73c\ub85c \uc18c\ud1b5 AI\ub294 \uac10\uc815\uc744 \ud749\ub0b4 \ub0bc \uc218 \uc788\uc9c0\ub9cc \uc9c4\uc815\ud55c \uacf5\uac10\uc740 \ubd88\uac00\ub2a5 \u2696\ufe0f \uc724\ub9ac\uc801 \ud310\ub2e8 AI\uc758 \uacb0\uc815\uc774 \uc633\uc740\uc9c0 \uadf8\ub978\uc9c0 \ud310\ub2e8\ud558\uace0 \uac10\ub3c5 AI\uac00 \uc798\ubabb\ub41c \uacb0\uc815\uc744 \ub0b4\ub9b4 \ub54c \ubc14\ub85c\uc7a1\uc744 \uc218 \uc788\ub294 \uac74 \uc778\uac04\ubfd0 \ud83e\udd1d AI\uc640\uc758 \ud611\uc5c5 \ub2a5\ub825 AI \ub3c4\uad6c\ub97c \uc798 \uc774\ud574\ud558\uace0 \ud6a8\uacfc\uc801\uc73c\ub85c \ud65c\uc6a9 AI\ub97c \uc801\uc73c\ub85c \ubcf4\uc9c0 \uc54a\uace0 \ub3c4\uad6c\ub85c \uc798 \uc4f0\ub294 \uac83\uc774 \ud575\uc2ec \uacbd\uc7c1\ub825 \ud83c\udfaf \ubaa9\ud45c \uc124\uc815 \ubb34\uc5c7\uc744 \uc704\ud574 AI\ub97c \uc0ac\uc6a9\ud560\uc9c0 \ubc29\ud5a5\uc744 \uc815\ud558\ub294 \ub2a5\ub825 AI\ub294 \ubaa9\ud45c\ub97c \uc2a4\uc2a4\ub85c \uc815\ud558\uc9c0 \ubabb\ud568, \ubc29\ud5a5\uc740 \ud56d\uc0c1 \uc778\uac04\uc774 \uc81c\uc2dc <p>\ud83c\udf1f \uacb0\ub860: AI\uac00 \uc544\ubb34\ub9ac \ubc1c\uc804\ud574\ub3c4, \"\uc65c \ud574\uc57c \ud558\ub294\uac00?\" \ub97c \ubb3b\ub294 \ub2a5\ub825, \"\uc774\uac8c \uc633\uc740\uac00?\" \ub97c \ud310\ub2e8\ud558\ub294 \ub2a5\ub825, \"\uc0ac\ub78c\uc744 \uc704\ud55c \uac83\uc778\uac00?\" \ub97c \uace0\ubbfc\ud558\ub294 \ub2a5\ub825\uc740 \uc5b8\uc81c\ub098 \uc778\uac04\uc758 \ubaab\uc73c\ub85c \ub0a8\uc2b5\ub2c8\ub2e4.</p>"},{"location":"chapter01/#_5","title":"\u2705 \ub9c8\ubb34\ub9ac \u2014 \ub9c8\uc778\ub4dc\ub9f5\uc73c\ub85c \uc815\ub9ac\ud558\uae30","text":"<p>\uc774\ubc88 \uc218\uc5c5\uc5d0\uc11c \ubc30\uc6b4 \ub0b4\uc6a9\uc744 \ub9c8\uc778\ub4dc\ub9f5\uc73c\ub85c \uc9c1\uc811 \uc815\ub9ac\ud574\ubd05\uc2dc\ub2e4. \ube48\uce78\uc744 \ucc44\uc6b0\uba74\uc11c \ud575\uc2ec \uac1c\ub150\uc744 \ub2e4\uc2dc \ud55c \ubc88 \ub5a0\uc62c\ub824\ubcf4\uc138\uc694.</p> \ud83e\udd16 \uc778\uacf5\uc9c0\ub2a5\uacfc \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \u2460 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \uac1c\ub150\uacfc \ud2b9\uc131 \uc815\uc758 ________________ \uc6d0\ub9ac ________________ \ub300\ud45c \uc0ac\ub840 ________________ \u2461 \uc778\uacf5\uc9c0\ub2a5\uc758 \ubc1c\uc804\uacfc \uc778\uac04\u00b7AI\uc758 \uc5ed\ud560 AI \ubc1c\uc804 \ub2e8\uacc4 ________________ AI \uc21c\uae30\ub2a5 ________________ AI \uc5ed\uae30\ub2a5 ________________ \u2462 \uc778\uacf5\uc9c0\ub2a5 \uc2dc\ub300\uc5d0\uc11c \uc778\uac04\uc758 \uc5ed\ud560 \uc778\uac04\ub9cc\uc758 \uc5ed\ub7c9 ________________ AI\uc640 \ud611\uc5c5 \ubc29\ubc95 ________________ \ubbf8\ub798\uc5d0 \ud544\uc694\ud55c \uc5ed\ub7c9 ________________"},{"location":"chapter01/#_6","title":"\ud83d\udcac \uc624\ub298 \uc218\uc5c5 \uc131\ucc30","text":"<p>\ub2e4\uc74c \uc9c8\ubb38\uc5d0 \uc790\uc720\ub86d\uac8c \ub2f5\ud558\uba70 \uc624\ub298 \ubc30\uc6b4 \ub0b4\uc6a9\uc744 \ub418\ub3cc\uc544\ubd05\uc2dc\ub2e4.</p> <p>Q1. \uc624\ub298 \ubc30\uc6b4 \ub0b4\uc6a9 \uc911 \uac00\uc7a5 \uc778\uc0c1 \uae4a\uc5c8\ub358 \uac83\uc740 \ubb34\uc5c7\uc778\uac00\uc694?</p> <p>\ud83d\udcdd \u00a0</p> <p> </p> <p> </p> <p>Q2. \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 '\uc778\uc2dd \u2192 \ud310\ub2e8 \u2192 \ud589\ub3d9' \uc6d0\ub9ac\ub97c \ub0b4 \uc77c\uc0c1 \uc18d AI \ud558\ub098\uc5d0 \uc801\uc6a9\ud574\uc11c \uc124\uba85\ud574\ubcf4\uc138\uc694.</p> <p>\ud83d\udcdd \u00a0</p> <p> </p> <p> </p> <p>Q3. AI \uc2dc\ub300\ub97c \uc0b4\uc544\uac08 \ub098\uc5d0\uac8c \uac00\uc7a5 \ud544\uc694\ud55c \uc5ed\ub7c9\uc740 \ubb34\uc5c7\uc774\ub77c\uace0 \uc0dd\uac01\ud558\ub098\uc694? \uadf8 \uc774\uc720\ub294?</p> <p>\ud83d\udcdd \u00a0</p> <p> </p> <p> </p>"},{"location":"chapter01/#_7","title":"\ud83d\udccc \ud575\uc2ec \uc815\ub9ac","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0, \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uba70, \ubaa9\ud45c\ub97c \uc704\ud574 \ud589\ub3d9\ud558\ub294 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4. AI\uac00 \ubc1c\uc804\ud560\uc218\ub85d \uc778\uac04\uc740 \ub2e8\uc21c \uc791\uc5c5 \ub300\uc2e0 \ucc3d\uc758, \uacf5\uac10, \uc724\ub9ac\uc801 \ud310\ub2e8\uc774\ub77c\ub294 \ub354 \ubcf8\uc9c8\uc801\uc778 \uc5ed\ud560\uc5d0 \uc9d1\uc911\ud558\uac8c \ub429\ub2c8\ub2e4. \uc778\uac04\uacfc AI\ub294 \uacbd\uc7c1\uc790\uac00 \uc544\ub2cc, \ud611\ub825\ud558\ub294 \ud30c\ud2b8\ub108\uc785\ub2c8\ub2e4. \ud83e\udd1d</p>"}]}