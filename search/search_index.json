{"config":{"lang":["ko","en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u2163. \uc778\uacf5\uc9c0\ub2a5","text":"<p>\uc778\uacf5\uc9c0\ub2a5 \uc2dc\ub300\uc758 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \uac1c\ub150\uc744 \uc774\ud574\ud558\uace0, \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud558\ub294 1\ucc28\uc2dc \uc218\uc5c5 \uad50\uc7ac\uc785\ub2c8\ub2e4.</p>"},{"location":"#_1","title":"\ubaa9\ucc28","text":""},{"location":"#part-1-01","title":"Part 1: 01. \uc778\uacf5\uc9c0\ub2a5\uacfc \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8","text":"<ul> <li>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \uc774\ud574\ud558\uace0 \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud558\uae30</li> </ul> <p>\uac15\uc815\ud76c \u00b7 \uad11\uc8fc\ub3d9\uc2e0\uc5ec\uc790\uace0\ub4f1\ud559\uad50 \u00b7 2026-03-30 \u00b7 \uac80\ud1a0: (\ubbf8\uc9c0\uc815)</p> <p>EduFlow</p>"},{"location":"chapter01/","title":"\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \uc774\ud574\ud558\uace0 \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud558\uae30","text":""},{"location":"chapter01/#ai","title":"\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \uc774\ud574\ud558\uace0 \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud558\uae30","text":""},{"location":"chapter01/#01","title":"01. \uc778\uacf5\uc9c0\ub2a5\uacfc \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8","text":"<p>\"\uae30\uacc4\uac00 \uc0dd\uac01\ud560 \uc218 \uc788\uc744\uae4c?\"  \u2014 \uc568\ub7f0 \ud29c\ub9c1(1950)\uc774 \ub358\uc9c4 \uc774 \uc9c8\ubb38 \ud558\ub098\uac00, \uc624\ub298\ub0a0 \uc6b0\ub9ac \uacc1\uc758 AI\ub97c \ub9cc\ub4e4\uc5b4\ub0c8\uc2b5\ub2c8\ub2e4.</p>"},{"location":"chapter01/#_1","title":"\ud83c\udfaf \uc774 \uc7a5\uc5d0\uc11c \ubc30\uc6b0\ub294 \uac83","text":"<ul> <li> \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uac1c\ub150\uacfc \uc791\ub3d9 \uc6d0\ub9ac(\uc778\uc2dd \u2192 \ud310\ub2e8 \u2192 \ud589\ub3d9)\ub97c \uc124\uba85\ud560 \uc218 \uc788\ub2e4.</li> <li> \uc778\uacf5\uc9c0\ub2a5 \ubc1c\uc804\uc5d0 \ub530\ub978 \uc778\uac04\uacfc \uc778\uacf5\uc9c0\ub2a5\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud560 \uc218 \uc788\ub2e4.</li> </ul>"},{"location":"chapter01/#_2","title":"\ud83c\udfaf \uc65c \uc774\uac78 \ubc30\uc6b0\ub098\uc694?","text":"<p>\uc5ec\ub7ec\ubd84\uc740 \uc624\ub298 \uc544\uce68\uc5d0\ub3c4 AI\ub97c \ub9cc\ub0ac\uc744 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4.  \uc2a4\ub9c8\ud2b8\ud3f0\uc758 \uc54c\ub78c\uc774 \uc218\uba74 \ud328\ud134\uc744 \ubd84\uc11d\ud574 \ucd5c\uc801\uc758 \uc2dc\uac04\uc5d0 \uc6b8\ub838\uc744 \uc218\ub3c4 \uc788\uace0,  \uc720\ud29c\ube0c\uac00 \"\ub108 \uc774\uac70 \uc88b\uc544\ud560\uac78?\" \ud558\uba70 \uc601\uc0c1\uc744 \ucd94\ucc9c\ud588\uc744 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \ud83c\udfb5</p> <p>\ud558\uc9c0\ub9cc \uc774\ub7f0 \uc9c8\ubb38\uc744 \ud574\ubcf8 \uc801 \uc788\ub098\uc694?</p> <p>\"\uc774 AI\ub294 \uc5b4\ub5bb\uac8c \ub098\uc5d0\uac8c \ub531 \ub9de\ub294 \uac78 \uace8\ub77c\uc8fc\ub294 \uac78\uae4c?\" \"AI\uac00 \ud560 \uc218 \uc788\ub294 \uc77c\uacfc \uc0ac\ub78c\ub9cc\uc774 \ud560 \uc218 \uc788\ub294 \uc77c\uc740 \ubb50\uac00 \ub2e4\ub97c\uae4c?\"</p> <p>\uc774 \uc218\uc5c5\uc5d0\uc11c\ub294 AI\uc758 \ud575\uc2ec \uac1c\ub150\uc778 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \ubc30\uc6c1\ub2c8\ub2e4.  \uc774 \uac1c\ub150\uc744 \uc774\ud574\ud558\uba74 \ub274\uc2a4\uc5d0 \ub098\uc624\ub294 AI \uae30\uc220\uc774 \uc5b4\ub5a4 \uc6d0\ub9ac\ub85c \uc791\ub3d9\ud558\ub294\uc9c0 \uc2a4\uc2a4\ub85c \ubd84\uc11d\ud560 \uc218 \uc788\uac8c \ub418\uace0, \uc55e\uc73c\ub85c AI \uc2dc\ub300\ub97c \uc0b4\uc544\uac00\ub294 \ub370 \uaf2d \ud544\uc694\ud55c \uad00\uc810\uc744 \uac00\uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. </p>"},{"location":"chapter01/#_3","title":"\u23f1\ufe0f \uc218\uc5c5 \ud750\ub984","text":"\ub2e8\uacc4 \ud65c\ub3d9 \uc2dc\uac04 1\ub2e8\uacc4 \ud83c\udfac \ub3c4\uc785 \u2014 \ud29c\ub9c1 \ud14c\uc2a4\ud2b8, \uae30\uacc4\ub3c4 \uc0dd\uac01\ud560 \uc218 \uc788\uc744\uae4c? 8\ubd84 2\ub2e8\uacc4 \ud83d\udcda \uac1c\ub150 \ud559\uc2b5 \u2014 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uc815\uc758\uc640 \uc791\ub3d9 \uc6d0\ub9ac 15\ubd84 3\ub2e8\uacc4 \ud83d\udd28 \ud559\uc0dd \ud65c\ub3d9 \u2014 \uc2e4\uc0dd\ud65c \uc0ac\ub840 \ubd84\ub958\ud45c \uc791\uc131\ud558\uae30 12\ubd84 4\ub2e8\uacc4 \ud83d\udd0d \uc2ec\ud654 \ud0d0\uc0c9 \u2014 \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560 \ube44\uad50 10\ubd84 5\ub2e8\uacc4 \u2705 \ub9c8\ubb34\ub9ac \u2014 \ub9c8\uc778\ub4dc\ub9f5 \uc815\ub9ac\uc640 \uc131\ucc30 5\ubd84"},{"location":"chapter01/#1","title":"1\ub2e8\uacc4: \ud83c\udfac \ub3c4\uc785 \u2014 \uae30\uacc4\ub3c4 \uc0dd\uac01\ud560 \uc218 \uc788\uc744\uae4c?","text":""},{"location":"chapter01/#_4","title":"\ud29c\ub9c1 \ud14c\uc2a4\ud2b8 \uc774\uc57c\uae30","text":"<p>1950\ub144, \uc601\uad6d\uc758 \uc218\ud559\uc790 \uc568\ub7f0 \ud29c\ub9c1(Alan Turing)\uc740 \ud55c \uac00\uc9c0 \uc7ac\ubbf8\uc788\ub294 \uc2e4\ud5d8\uc744 \uc81c\uc548\ud588\uc2b5\ub2c8\ub2e4.</p> <p>\ud83d\udcac \"\ubcbd \ub4a4\uc5d0 \ub204\uad70\uac00\uac00 \uc788\uc5b4\uc694. \uc5ec\ub7ec\ubd84\uc740 \ud0a4\ubcf4\ub4dc\ub85c \uc9c8\ubb38\uc744 \ubcf4\ub0b4\uace0, \ud654\uba74\uc73c\ub85c \ub2f5\ubcc0\uc744 \ubc1b\uc2b5\ub2c8\ub2e4.  \ub300\ud654\uac00 \ub05d\ub09c \ub4a4, \uc0c1\ub300\uac00 \uc0ac\ub78c\uc778\uc9c0 \uae30\uacc4\uc778\uc9c0 \uad6c\ubcc4\ud560 \uc218 \uc5c6\ub2e4\uba74 \u2014 \uadf8 \uae30\uacc4\ub294 '\uc0dd\uac01\ud55c\ub2e4'\uace0 \ubcfc \uc218 \uc788\uc9c0 \uc54a\uc744\uae4c\uc694?\"</p> <p>\uc774\uac83\uc774 \ubc14\ub85c \ud29c\ub9c1 \ud14c\uc2a4\ud2b8(Turing Test)\uc785\ub2c8\ub2e4. \uae30\uacc4\uc758 \uc9c0\ub2a5\uc744 \ud310\ubcc4\ud558\ub294 \ucd5c\ucd08\uc758 \uc0ac\uace0\uc2e4\ud5d8\uc774\uc5c8\uc8e0.</p> sequenceDiagram     participant \uc2ec\uc0ac\uc790 as \ud83e\uddd1 \uc2ec\uc0ac\uc790     participant \ubcbd as \ud83e\uddf1 \ubcbd(\uac00\ub9bc\ub9c9)     participant \uc751\ub2f5\uc790 as \ud83e\udd16\u2753 \uc751\ub2f5\uc790&lt;br/&gt;(\uc0ac\ub78c \ub610\ub294 \uae30\uacc4)      \uc2ec\uc0ac\uc790-&gt;&gt;\ubcbd: \uc9c8\ubb38\uc744 \ubcf4\ub0c5\ub2c8\ub2e4     \ubcbd-&gt;&gt;\uc751\ub2f5\uc790: \uc9c8\ubb38 \uc804\ub2ec     \uc751\ub2f5\uc790-&gt;&gt;\ubcbd: \ub2f5\ubcc0 \uc791\uc131     \ubcbd-&gt;&gt;\uc2ec\uc0ac\uc790: \ub2f5\ubcc0 \uc804\ub2ec     \uc2ec\uc0ac\uc790-&gt;&gt;\uc2ec\uc0ac\uc790: \uc0ac\ub78c\uc77c\uae4c? \uae30\uacc4\uc77c\uae4c?"},{"location":"chapter01/#_5","title":"\ud83e\udd14 \uc7a0\uae50, \uc0dd\uac01\ud574\ubd05\uc2dc\ub2e4","text":"<p>\uc5ec\ub7ec\ubd84\uc774 \uc2ec\uc0ac\uc790\ub77c\uace0 \uc0c1\uc0c1\ud574\ubcf4\uc138\uc694. \ub2e4\uc74c \ub450 \ub2f5\ubcc0 \uc911 \uc5b4\ub5a4 \uac83\uc774 AI\uc77c\uae4c\uc694?</p> <p>\uc9c8\ubb38: \"\uc624\ub298 \uae30\ubd84\uc774 \uc5b4\ub54c?\"</p> \uc751\ub2f5\uc790 A \uc751\ub2f5\uc790 B \"\uc624\ub298\uc740 \uc880 \ud53c\uace4\ud574\uc694. \uc5b4\uc82f\ubc24\uc5d0 \ub2a6\uac8c\uae4c\uc9c0 \ub4dc\ub77c\ub9c8\ub97c \ubd10\uc11c\uc694. \uadfc\ub370 \ub0a0\uc528\uac00 \uc88b\uc73c\ub2c8\uae4c \uae30\ubd84\uc774 \ub098\uc544\uc9c0\ub124\uc694!\" \"\uac10\uc815\uc740 \ubcf5\uc7a1\ud55c \uc8fc\uad00\uc801 \uacbd\ud5d8\uc785\ub2c8\ub2e4. \ud604\uc7ac \uc81c \uc0c1\ud0dc\ub294 \uc815\uc0c1 \uc791\ub3d9 \uc911\uc785\ub2c8\ub2e4.\" <p>\uc544\ub9c8 \uc751\ub2f5\uc790 B\uac00 \uae30\uacc4\ub77c\uace0 \ub290\ub07c\uc168\uc744 \uac81\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \ucd5c\uadfc\uc758 AI(\uc608: ChatGPT)\ub294 \uc751\ub2f5\uc790 A\ucc98\ub7fc \uc790\uc5f0\uc2a4\ub7fd\uac8c \ub300\ud654\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uc81c \ud29c\ub9c1 \ud14c\uc2a4\ud2b8\ub97c \ud1b5\uacfc\ud558\ub294 AI\uac00 \uc2e4\uc81c\ub85c \ub4f1\uc7a5\ud55c \uc2dc\ub300\uac00 \ub41c \uac83\uc774\uc8e0! \ud83d\ude2e</p> <p>\uadf8\ub807\ub2e4\uba74 \uc9c8\ubb38\uc744 \ubc14\uafd4\ubd05\uc2dc\ub2e4.</p> <p>AI\uac00 \ub2e8\uc21c\ud788 \"\ub300\ud654\ub97c \uc798\ud558\ub294 \uac83\"\uc744 \ub118\uc5b4, \uc2e4\uc81c\ub85c \ubb34\uc5b8\uac00\ub97c \uc778\uc2dd\ud558\uace0, \ud310\ub2e8\ud558\uace0, \ud589\ub3d9\ud558\ub294 \uc874\uc7ac\uac00 \ub420 \uc218 \uc788\uc744\uae4c\uc694?</p> <p>\uc774 \uc9c8\ubb38\uc758 \ub2f5\uc744 \ucc3e\uae30 \uc704\ud574, \uc774\uc81c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub77c\ub294 \ud575\uc2ec \uac1c\ub150\uc744 \ubc30\uc6cc\ubd05\uc2dc\ub2e4.</p>"},{"location":"chapter01/#2","title":"2\ub2e8\uacc4: \ud83d\udcda \ud575\uc2ec \uac1c\ub150","text":"<p>\uc774\ubc88 \uc218\uc5c5\uc5d0\uc11c\ub294 \ud06c\uac8c \ub450 \uac00\uc9c0 \ud575\uc2ec \uac1c\ub150\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4.</p>   ### \ud575\uc2ec \uac1c\ub150 1\ufe0f\u20e3 **\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub780 \ubb34\uc5c7\uc778\uac00?** \ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0, \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uc5ec, \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud574 \ud589\ub3d9\ud558\ub294 \uc2dc\uc2a4\ud15c  ### \ud575\uc2ec \uac1c\ub150 2\ufe0f\u20e3 **\uc778\uac04\uacfc AI\uc758 \uc5ed\ud560 \ucc28\uc774** AI\uac00 \uc798\ud558\ub294 \uc77c\uacfc \uc778\uac04\ub9cc\uc774 \ud560 \uc218 \uc788\ub294 \uc77c, \uadf8\ub9ac\uace0 \ub458\uc774 \ud611\ub825\ud558\ub294 \uc601\uc5ed"},{"location":"chapter01/#1_1","title":"\ud83d\udcda \ud575\uc2ec \uac1c\ub150 1: \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8","text":""},{"location":"chapter01/#1_2","title":"1. \ube44\uc720","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \ub9c8\uce58 \"\ub611\ub611\ud55c \uac1c\ubbf8\"\uc640 \uac19\uc544\uc694.</p> <p>\uac1c\ubbf8 \ud55c \ub9c8\ub9ac\ub97c \ub5a0\uc62c\ub824\ubcf4\uc138\uc694. \uac1c\ubbf8\ub294 \uc774\ub7f0 \uc77c\uc744 \ud569\ub2c8\ub2e4: - \uc778\uc2dd: \ub354\ub4ec\uc774\ub85c \uc8fc\ubcc0 \ud658\uacbd(\uba39\uc774 \ub0c4\uc0c8, \uc7a5\uc560\ubb3c, \ub3d9\ub8cc \uac1c\ubbf8)\uc744 \uac10\uc9c0\ud569\ub2c8\ub2e4.    - \ud310\ub2e8: \"\uc774 \ubc29\ud5a5\uc5d0 \uba39\uc774\uac00 \uc788\uad6c\ub098, \uc774\ucabd\uc73c\ub85c \uac00\uc57c\uaca0\ub2e4\"\uace0 \uacb0\uc815\ud569\ub2c8\ub2e4.  - \ud589\ub3d9: \uc2e4\uc81c\ub85c \uba39\uc774\ub97c \ud5a5\ud574 \uc774\ub3d9\ud558\uace0, \uc9d1\uc73c\ub85c \uc6b4\ubc18\ud569\ub2c8\ub2e4.  </p> <p>\uac1c\ubbf8\ub294 \uc544\uc8fc \ub2e8\uc21c\ud55c \uaddc\uce59\ub9cc\uc73c\ub85c\ub3c4 \uba39\uc774\ub97c \ucc3e\uace0, \uc7a5\uc560\ubb3c\uc744 \ud53c\ud558\uace0, \uc9d1\uc73c\ub85c \ub3cc\uc544\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4.  \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub3c4 \uc774\uc640 \ube44\uc2b7\ud569\ub2c8\ub2e4.  \uc8fc\ubcc0\uc744 \uac10\uc9c0(\uc778\uc2dd)\ud558\uace0, \ubb34\uc5c7\uc744 \ud560\uc9c0 \uacb0\uc815(\ud310\ub2e8)\ud558\uace0, \uc2e4\uc81c\ub85c \uc2e4\ud589(\ud589\ub3d9)\ud558\ub294 \uac83\uc774\uc8e0.</p> <p>\ub2e8, \uac1c\ubbf8\ub294 \ubcf8\ub2a5\uc5d0 \ub530\ub77c \uc6c0\uc9c1\uc774\uc9c0\ub9cc,  AI \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \ub370\uc774\ud130\uc640 \uc54c\uace0\ub9ac\uc998\uc5d0 \ub530\ub77c \uc6c0\uc9c1\uc778\ub2e4\ub294 \ucc28\uc774\uac00 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"chapter01/#2_1","title":"2. \uc815\uc758","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8(Intelligent Agent)\ub780,  \ud658\uacbd(Environment)\uc744 \uc13c\uc11c(Sensor)\ub85c \uc778\uc2dd\ud558\uace0,  \ub0b4\ubd80 \uaddc\uce59\uc774\ub098 \ud559\uc2b5\ub41c \ubaa8\ub378\ub85c \ud310\ub2e8\ud55c \ub4a4,  \uc791\ub3d9\uae30(Actuator)\ub97c \ud1b5\ud574 \ud589\ub3d9\ud558\uc5ec  \uc8fc\uc5b4\uc9c4 \ubaa9\ud45c(Goal)\ub97c \ub2ec\uc131\ud558\ub824\ub294 \uc2dc\uc2a4\ud15c\uc744 \ub9d0\ud569\ub2c8\ub2e4.</p> <p>\uc774 \uc815\uc758\uc5d0\ub294 \ud575\uc2ec \ud0a4\uc6cc\ub4dc\uac00 5\uac1c \ub4e4\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \ud558\ub098\uc529 \ud480\uc5b4\ubcfc\uac8c\uc694.</p> \ud0a4\uc6cc\ub4dc \uc758\ubbf8 \uc26c\uc6b4 \ube44\uc720 \uc5d0\uc774\uc804\ud2b8(Agent) \uc2a4\uc2a4\ub85c \ud589\ub3d9\ud558\ub294 \uc8fc\uccb4 \uc2ec\ubd80\ub984\uafbc, \ub300\ub9ac\uc778 \ud658\uacbd(Environment) \uc5d0\uc774\uc804\ud2b8\uac00 \ud65c\ub3d9\ud558\ub294 \uc138\uacc4 \uac1c\ubbf8\uc5d0\uac8c\ub294 \uc232, \uc790\uc728\uc8fc\ud589\ucc28\uc5d0\uac8c\ub294 \ub3c4\ub85c \uc13c\uc11c(Sensor) \ud658\uacbd \uc815\ubcf4\ub97c \ubc1b\uc544\ub4e4\uc774\ub294 \uc7a5\uce58 \uac1c\ubbf8\uc758 \ub354\ub4ec\uc774, \uc0ac\ub78c\uc758 \ub208\u00b7\uadc0 \ud310\ub2e8(Decision) \uc778\uc2dd\ud55c \uc815\ubcf4\ub97c \ubc14\ud0d5\uc73c\ub85c \ubb34\uc5c7\uc744 \ud560\uc9c0 \uacb0\uc815 \ub1cc\uac00 \uc0dd\uac01\ud558\ub294 \uacfc\uc815 \uc791\ub3d9\uae30(Actuator) \ud310\ub2e8 \uacb0\uacfc\ub97c \uc2e4\ud589\ud558\ub294 \uc7a5\uce58 \uac1c\ubbf8\uc758 \ub2e4\ub9ac, \ub85c\ubd07\uc758 \ubc14\ud034"},{"location":"chapter01/#3","title":"3. \uc791\ub3d9 \uc6d0\ub9ac: \uc778\uc2dd \u2192 \ud310\ub2e8 \u2192 \ud589\ub3d9","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \ud56d\uc0c1 \uc138 \ub2e8\uacc4 \uc0ac\uc774\ud074\ub85c \uc791\ub3d9\ud569\ub2c8\ub2e4. \uc774\uac83\uc774 \uac00\uc7a5 \uc911\uc694\ud55c \ud575\uc2ec \uc6d0\ub9ac\uc785\ub2c8\ub2e4!</p> \ud83c\udf0d \ud658\uacbd (Environment) \ud83d\udc41\ufe0f \uc778\uc2dd (Perception) \uc13c\uc11c\ub85c \uc815\ubcf4 \uc218\uc9d1 \ud83e\udde0 \ud310\ub2e8 (Decision) \uaddc\uce59\u00b7\ud559\uc2b5\uc73c\ub85c \uacb0\uc815 \ud83e\uddbe \ud589\ub3d9 (Action) \uc791\ub3d9\uae30\ub85c \uc2e4\ud589 \ud83d\udd04 \ud589\ub3d9 \uacb0\uacfc\uac00 \ud658\uacbd\uc744 \ubc14\uafb8\uace0, \ub2e4\uc2dc \uc778\uc2dd\uc73c\ub85c \uc774\uc5b4\uc9d0 <p>\uc774 \uc138 \ub2e8\uacc4\ub294 \ud55c \ubc88\uc73c\ub85c \ub05d\ub098\ub294 \uac83\uc774 \uc544\ub2c8\ub77c, \uacc4\uc18d \ubc18\ubcf5\ub429\ub2c8\ub2e4. \ud589\ub3d9\uc758 \uacb0\uacfc\uac00 \ud658\uacbd\uc744 \ubcc0\ud654\uc2dc\ud0a4\uace0, \ubcc0\ud654\ub41c \ud658\uacbd\uc744 \ub2e4\uc2dc \uc778\uc2dd\ud558\uc5ec \uc0c8\ub85c\uc6b4 \ud310\ub2e8\uacfc \ud589\ub3d9\uc73c\ub85c \uc774\uc5b4\uc9c0\ub294 \uc21c\ud658 \uad6c\uc870\uc785\ub2c8\ub2e4.</p>"},{"location":"chapter01/#4-1","title":"4. \uc608\uc2dc1: \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28 \ud83d\ude97","text":"<p>\uac00\uc7a5 \ub300\ud45c\uc801\uc778 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8, \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\ub97c \uc0b4\ud3b4\ubd05\uc2dc\ub2e4.</p> flowchart LR     subgraph \uc778\uc2dd[\"\ud83d\udc41\ufe0f \uc778\uc2dd\"]         A1[\uce74\uba54\ub77c\ub85c \ucc28\uc120 \uac10\uc9c0]         A2[\ub808\uc774\ub354\ub85c \uc55e\ucc28 \uac70\ub9ac \uce21\uc815]         A3[GPS\ub85c \ud604\uc7ac \uc704\uce58 \ud30c\uc545]     end     subgraph \ud310\ub2e8[\"\ud83e\udde0 \ud310\ub2e8\"]         B1[\"\uc55e\ucc28\uc640 \uac70\ub9ac\uac00 \uac00\uae4c\uc6c0&lt;br/&gt;\u2192 \uc18d\ub3c4\ub97c \uc904\uc5ec\uc57c \ud568\"]     end     subgraph \ud589\ub3d9[\"\ud83e\uddbe \ud589\ub3d9\"]         C1[\ube0c\ub808\uc774\ud06c \uc791\ub3d9]         C2[\ud578\ub4e4 \ubc29\ud5a5 \uc720\uc9c0]     end     \uc778\uc2dd --&gt; \ud310\ub2e8 --&gt; \ud589\ub3d9 \uad6c\uc131 \uc694\uc18c \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\uc758 \uacbd\uc6b0 \uc5d0\uc774\uc804\ud2b8 \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28 \ud658\uacbd \ub3c4\ub85c, \ub2e4\ub978 \ucc28\ub7c9, \ubcf4\ud589\uc790, \uc2e0\ud638\ub4f1, \ub0a0\uc528 \uc13c\uc11c \uce74\uba54\ub77c, \ub808\uc774\ub354, \ub77c\uc774\ub2e4(LiDAR), GPS \ud310\ub2e8 \uadfc\uac70 \ud559\uc2b5\ub41c \ub525\ub7ec\ub2dd \ubaa8\ub378 + \uad50\ud1b5 \uaddc\uce59 \uc791\ub3d9\uae30 \ud578\ub4e4, \ube0c\ub808\uc774\ud06c, \uac00\uc18d \ud398\ub2ec \ubaa9\ud45c \ubaa9\uc801\uc9c0\uae4c\uc9c0 \uc548\uc804\ud558\uac8c \uc774\ub3d9"},{"location":"chapter01/#5-2","title":"5. \uc608\uc2dc2: \ub85c\ubd07 \uccad\uc18c\uae30 \ud83e\udd16\ud83e\uddf9","text":"<p>\uc880 \ub354 \uce5c\uadfc\ud55c \uc608\uc2dc\ub3c4 \ubcfc\uae4c\uc694? \uc9d1\uc5d0\uc11c \ud754\ud788 \ubcfc \uc218 \uc788\ub294 \ub85c\ubd07 \uccad\uc18c\uae30\uc785\ub2c8\ub2e4.</p> \uad6c\uc131 \uc694\uc18c \ub85c\ubd07 \uccad\uc18c\uae30\uc758 \uacbd\uc6b0 \uc5d0\uc774\uc804\ud2b8 \ub85c\ubd07 \uccad\uc18c\uae30 \ud658\uacbd \uac70\uc2e4, \uce68\uc2e4, \uac00\uad6c, \ubcbd, \uba3c\uc9c0 \uc13c\uc11c \uc801\uc678\uc120 \uc13c\uc11c(\uc7a5\uc560\ubb3c \uac10\uc9c0), \ub099\ud558 \ubc29\uc9c0 \uc13c\uc11c, \uba3c\uc9c0 \uac10\uc9c0 \uc13c\uc11c \ud310\ub2e8 \uadfc\uac70 \ub0b4\uc7a5\ub41c \uccad\uc18c \uc54c\uace0\ub9ac\uc998 (\uc9c0\uadf8\uc7ac\uadf8 \uacbd\ub85c, \uc7a5\uc560\ubb3c \ud68c\ud53c \uaddc\uce59) \uc791\ub3d9\uae30 \ubc14\ud034(\uc774\ub3d9), \ube0c\ub7ec\uc2dc(\uc4f8\uae30), \ud761\uc785 \ubaa8\ud130(\uba3c\uc9c0 \ube68\uc544\ub4e4\uc774\uae30) \ubaa9\ud45c \uc9d1 \uc548 \uc804\uccb4\ub97c \ube60\uc9d0\uc5c6\uc774 \uccad\uc18c <p>\ub85c\ubd07 \uccad\uc18c\uae30\uc758 \uc778\uc2dd-\ud310\ub2e8-\ud589\ub3d9 \uc0ac\uc774\ud074 \uc608\uc2dc:</p> <ol> <li>\uc778\uc2dd : \"\uc55e\uc5d0 \uc758\uc790 \ub2e4\ub9ac\uac00 \uc788\ub2e4!\" (\uc801\uc678\uc120 \uc13c\uc11c)</li> <li>\ud310\ub2e8 : \"\uc624\ub978\ucabd\uc73c\ub85c \ub3cc\uc544\uc11c \uc6b0\ud68c\ud558\uc790\" (\uc7a5\uc560\ubb3c \ud68c\ud53c \uc54c\uace0\ub9ac\uc998)</li> <li>\ud589\ub3d9 : \uc624\ub978\ucabd\uc73c\ub85c \ubc29\ud5a5\uc744 \ud2c0\uace0 \uc758\uc790\ub97c \ub3cc\uc544\uc11c \uacc4\uc18d \uccad\uc18c</li> </ol> <p>\uc774 \uacfc\uc815\uc774 \uc218\ucc9c \ubc88 \ubc18\ubcf5\ub418\uba74\uc11c \ubc29 \uc804\uccb4\ub97c \uae68\ub057\ud558\uac8c \uccad\uc18c\ud558\ub294 \uac83\uc774\uc8e0!</p> <p>\ud83d\udccc \ud575\uc2ec \ud3ec\uc778\ud2b8: \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \ubc18\ub4dc\uc2dc \ub85c\ubd07\ucc98\ub7fc \ubb3c\ub9ac\uc801 \ud615\ud0dc\ub97c \uac00\uc838\uc57c \ud558\ub294 \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4.  \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub3c4 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uac00 \ub420 \uc218 \uc788\uc5b4\uc694!  \uc608\ub97c \ub4e4\uc5b4, \uc720\ud29c\ube0c \ucd94\ucc9c \uc54c\uace0\ub9ac\uc998\uc740  \uc5ec\ub7ec\ubd84\uc758 \uc2dc\uccad \uae30\ub85d(\uc778\uc2dd)  \u2192 \uc88b\uc544\ud560 \uc601\uc0c1 \uc608\uce21(\ud310\ub2e8)  \u2192 \ucd94\ucc9c \uc601\uc0c1 \ud45c\uc2dc(\ud589\ub3d9)\uc758 \uc0ac\uc774\ud074\ub85c \uc791\ub3d9\ud558\ub294  \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uc5d0\uc774\uc804\ud2b8\uc785\ub2c8\ub2e4.</p>"},{"location":"chapter01/#6","title":"6. \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uc720\ud615","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub294 \"\uc5bc\ub9c8\ub098 \ub611\ub611\ud55c\uac00\"\uc5d0 \ub530\ub77c \uc5ec\ub7ec \uc720\ud615\uc73c\ub85c \ub098\ub269\ub2c8\ub2e4.  \ucc98\uc74c\uc5d0\ub294 \ub2e8\uc21c\ud55c \uac83\ubd80\ud130 \uc2dc\uc791\ud574\uc11c, \uc810\uc810 \ubcf5\uc7a1\ud574\uc9c0\ub294 \uc21c\uc11c\ub85c \uc0b4\ud3b4\ubcfc\uac8c\uc694.</p> \uc720\ud615 \ud2b9\uc9d5 \ube44\uc720 \uc608\uc2dc \ub2e8\uc21c \ubc18\uc0ac \uc5d0\uc774\uc804\ud2b8 \ud604\uc7ac \uc0c1\ud669\ub9cc \ubcf4\uace0 \ubc14\ub85c \ud589\ub3d9 \"\ube68\uac04\ubd88\uc774\uba74 \uba48\ucdb0!\" \uac19\uc740 \ubc18\uc0ac \ud589\ub3d9 \uc790\ub3d9\ubb38 (\uc0ac\ub78c \uac10\uc9c0 \u2192 \uc5f4\ub9bc) \ubaa8\ub378 \uae30\ubc18 \uc5d0\uc774\uc804\ud2b8 \uc138\uc0c1\uc774 \uc5b4\ub5bb\uac8c \ub3cc\uc544\uac00\ub294\uc9c0 \ubaa8\ub378\uc744 \uac00\uc9c0\uace0 \uc788\uc74c \uacbd\ud5d8 \ub9ce\uc740 \uc6b4\uc804\uc790 \ub85c\ubd07 \uccad\uc18c\uae30 (\ubc29 \uad6c\uc870\ub97c \uae30\uc5b5) \ubaa9\ud45c \uae30\ubc18 \uc5d0\uc774\uc804\ud2b8 \ubaa9\ud45c\ub97c \uac00\uc9c0\uace0 \ucd5c\uc801\uc758 \ud589\ub3d9\uc744 \uc120\ud0dd \"\uc11c\uc6b8\uae4c\uc9c0 \ucd5c\ub2e8 \uacbd\ub85c\" \ucc3e\ub294 \ub0b4\ube44\uac8c\uc774\uc158 \uccb4\uc2a4 AI, \uacbd\ub85c \ud0d0\uc0c9 \ud559\uc2b5 \uc5d0\uc774\uc804\ud2b8 \uacbd\ud5d8\uc5d0\uc11c \ubc30\uc6b0\uace0 \uc810\uc810 \ub354 \uc798\ud558\uac8c \ub428 \uc5f0\uc2b5\ud560\uc218\ub85d \uc2e4\ub825 \ub290\ub294 \uc6b4\ub3d9\uc120\uc218 ChatGPT, \uc54c\ud30c\uace0 flowchart TB     A[\"\ud83d\udd30 \ub2e8\uc21c \ubc18\uc0ac \uc5d0\uc774\uc804\ud2b8&lt;br/&gt;(\uaddc\uce59\ub300\ub85c\ub9cc \ud589\ub3d9)\"] --&gt; B[\"\ud83d\udce6 \ubaa8\ub378 \uae30\ubc18 \uc5d0\uc774\uc804\ud2b8&lt;br/&gt;(\uc138\uc0c1\uc744 \uc774\ud574\ud568)\"]     B --&gt; C[\"\ud83c\udfaf \ubaa9\ud45c \uae30\ubc18 \uc5d0\uc774\uc804\ud2b8&lt;br/&gt;(\ubaa9\ud45c\ub97c \ucd94\uad6c\ud568)\"]     C --&gt; D[\"\ud83c\udf93 \ud559\uc2b5 \uc5d0\uc774\uc804\ud2b8&lt;br/&gt;(\uacbd\ud5d8\uc5d0\uc11c \ubc30\uc6c0)\"]      style A fill:#E3F2FD,stroke:#2196F3     style B fill:#E8F5E9,stroke:#4CAF50     style C fill:#FFF3E0,stroke:#FF9800     style D fill:#FCE4EC,stroke:#F44336 <p>\ud83c\udfaf \uae30\uc5b5 \ud301: \uc544\ub798\ub85c \uac08\uc218\ub85d \ub354 \"\ub611\ub611\ud55c\" \uc5d0\uc774\uc804\ud2b8\uc785\ub2c8\ub2e4.  \ucd5c\uadfc AI \uae30\uc220\uc758 \ubc1c\uc804\uc740 \ub300\ubd80\ubd84 \ud559\uc2b5 \uc5d0\uc774\uc804\ud2b8 \ubd84\uc57c\uc5d0\uc11c \uc774\ub8e8\uc5b4\uc9c0\uace0 \uc788\uc5b4\uc694!</p>"},{"location":"chapter01/#2-ai","title":"\ud83d\udcda \ud575\uc2ec \uac1c\ub150 2: \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560 \ucc28\uc774","text":""},{"location":"chapter01/#1_3","title":"1. \ube44\uc720","text":"<p>AI\ub294 \ub9c8\uce58 \"\ucd08\uace0\uc18d \uacc4\uc0b0\uae30\ub97c \uc7a5\ucc29\ud55c \uc131\uc2e4\ud55c \uc870\uc218\"\uc640 \uac19\uc544\uc694.</p> <p>\uc774\ub7f0 \uc7a5\uba74\uc744 \ub5a0\uc62c\ub824\ubcf4\uc138\uc694.  \uac74\ucd95\uac00(\uc778\uac04)\uc640 \uc870\uc218(AI)\uac00 \ud568\uaed8 \uac74\ubb3c\uc744 \uc124\uacc4\ud569\ub2c8\ub2e4.</p> <ul> <li>\uc870\uc218(AI): \uc218\ub9cc \uac00\uc9c0 \uac74\ucd95 \uad6c\uc870\uc758 \uac15\ub3c4 \uacc4\uc0b0\uc744 1\ucd08 \ub9cc\uc5d0 \ub05d\ub0b4\uace0, \ubc95\uaddc\uc5d0 \ub9de\ub294\uc9c0 \uc790\ub3d9 \uac80\ud1a0\ud569\ub2c8\ub2e4. \ubc24\uc0c8\uc6cc\ub3c4 \ud53c\uace4\ud558\uc9c0 \uc54a\uace0, \uc2e4\uc218 \uc5c6\uc774 \uc815\ud655\ud569\ub2c8\ub2e4.</li> <li>\uac74\ucd95\uac00(\uc778\uac04): \"\uc774 \uac74\ubb3c\uc5d0 \uc0ac\ub294 \uc0ac\ub78c\ub4e4\uc774 \ub9e4\uc77c \uc544\uce68 \ud587\uc0b4\uc744 \ubc1b\uc73c\uba70 \uae30\ubd84 \uc88b\uac8c \ucd9c\uadfc\ud588\uc73c\uba74 \uc88b\uaca0\uc5b4\"\ub77c\ub294 \uac00\uce58\uad00\uc744 \ub2f4\uc544 \ub514\uc790\uc778\uc744 \uacb0\uc815\ud569\ub2c8\ub2e4.</li> </ul> <p>\ub458 \ub2e4 \ud544\uc694\ud558\uc9c0\ub9cc, \ud558\ub294 \uc77c\uc758 \ubcf8\uc9c8\uc774 \ub2e4\ub985\ub2c8\ub2e4.</p>"},{"location":"chapter01/#2-ai-vs","title":"2. AI\uac00 \uc798\ud558\ub294 \uc77c vs \uc778\uac04\uc774 \uc798\ud558\ub294 \uc77c \ud83c\udd9a","text":""},{"location":"chapter01/#_6","title":"\u2705 \uc815\ub9ac\ud558\uae30","text":""},{"location":"chapter01/#_7","title":"\ud83d\udccc \uc774\ubc88 \uc2dc\uac04\uc5d0 \ubc30\uc6b4 \uac83","text":"\ud575\uc2ec \uac1c\ub150 \ub0b4\uc6a9 \uc778\uacf5\uc9c0\ub2a5 (AI) \uc778\uac04\uc758 \uc9c0\uc801 \ub2a5\ub825\uc744 \ucef4\ud4e8\ud130\ub85c \uad6c\ud604\ud55c \uae30\uc220 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0, \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uc5ec, \ubaa9\ud45c\ub97c \ub2ec\uc131\ud558\uae30 \uc704\ud574 \ud589\ub3d9\ud558\ub294 \uc2dc\uc2a4\ud15c \uc791\ub3d9 \uc6d0\ub9ac \uc778\uc2dd \u2192 \ud310\ub2e8 \u2192 \ud589\ub3d9\uc758 \uc21c\ud658 \uc0ac\uc774\ud074 PEAS \ud504\ub808\uc784\uc6cc\ud06c \uc131\ub2a5 \uae30\uc900(P) \u00b7 \ud658\uacbd(E) \u00b7 \uc561\ucd94\uc5d0\uc774\ud130(A) \u00b7 \uc13c\uc11c(S) \uc778\uac04 vs AI AI\ub294 \uc778\uac04\uc744 \ub300\uccb4\ud558\ub294 \uac83\uc774 \uc544\ub2cc, \ud611\uc5c5\ud558\ub294 \uc874\uc7ac"},{"location":"chapter01/#_8","title":"\ud83d\udccc \ud575\uc2ec \ud0a4\uc6cc\ub4dc","text":"<p><code>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8</code> <code>\uc778\uc2dd</code> <code>\ud310\ub2e8</code> <code>\ud589\ub3d9</code> <code>\uc13c\uc11c</code> <code>\uc561\ucd94\uc5d0\uc774\ud130</code> <code>PEAS</code> <code>\ud29c\ub9c1 \ud14c\uc2a4\ud2b8</code> <code>\ud611\uc5c5</code></p>"},{"location":"chapter01/#_9","title":"\ud83d\udccc \uc624\ub298\uc758 \uc131\ucc30 \uc9c8\ubb38","text":"<ol> <li>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uc778\uc2dd \u2192 \ud310\ub2e8 \u2192 \ud589\ub3d9 \uc6d0\ub9ac\ub97c \ub098\ub9cc\uc758 \ub9d0\ub85c \uc124\uba85\ud574\ubcf4\uc138\uc694.</li> <li>AI\uac00 \uc798\ud558\ub294 \uc77c\uacfc \uc778\uac04\ub9cc\uc774 \ud560 \uc218 \uc788\ub294 \uc77c\uc740 \uac01\uac01 \ubb34\uc5c7\uc778\uac00\uc694?</li> <li>\ubbf8\ub798\uc5d0 AI\uc640 \ud611\uc5c5\ud558\ub294 \ub098\uc758 \ubaa8\uc2b5\uc740 \uc5b4\ub5a4 \ubaa8\uc2b5\uc77c\uae4c\uc694?</li> </ol>"}]}