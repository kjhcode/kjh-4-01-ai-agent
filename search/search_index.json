{"config":{"lang":["ko","en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u2163. \uc778\uacf5\uc9c0\ub2a5","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uac1c\ub150\uacfc \ud2b9\uc131\uc744 \uc774\ud574\ud558\uace0, \uc778\uacf5\uc9c0\ub2a5 \uc2dc\ub300\uc5d0\uc11c \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud558\ub294 1\ucc28\uc2dc \ud63c\ud569\ud615 \uc778\ud130\ub799\ud2f0\ube0c \uc218\uc5c5 \uad50\uc7ac\uc785\ub2c8\ub2e4.</p>"},{"location":"#_1","title":"\ubaa9\ucc28","text":""},{"location":"#part-1-p1-01","title":"Part 1: P1: 01. \uc778\uacf5\uc9c0\ub2a5\uacfc \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8","text":"<ul> <li>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \uc774\ud574\ud558\uace0 \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud558\uae30</li> </ul> <p>\uac15\uc815\ud76c \u00b7 \uad11\uc8fc\ub3d9\uc2e0\uc5ec\uc790\uace0\ub4f1\ud559\uad50 \u00b7 2026-03-30 \u00b7 \uac80\ud1a0: (\ubbf8\uc9c0\uc815)</p> <p>EduFlow</p>"},{"location":"chapter01/","title":"\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \uc774\ud574\ud558\uace0 \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud558\uae30","text":""},{"location":"chapter01/#1-ai","title":"\ud83e\udd16 1\ucc28\uc2dc: \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \uc774\ud574\ud558\uace0 \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud558\uae30","text":"<p>Part 1 \u00b7 01. \uc778\uacf5\uc9c0\ub2a5\uacfc \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8</p>"},{"location":"chapter01/#_1","title":"\ud83c\udfaf \uc774 \uc7a5\uc5d0\uc11c \ubc30\uc6b0\ub294 \uac83","text":"<p>\uc774\ubc88 \ucc28\uc2dc\ub97c \ub9c8\uce58\uba74 \ub2e4\uc74c\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p> <ul> <li> \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uac1c\ub150\uacfc \ud575\uc2ec \ud2b9\uc131(\uc778\uc2dd \u2192 \ud310\ub2e8 \u2192 \ud589\ub3d9)\uc744 \ube44\uc720\uc640 \uc608\uc2dc\ub97c \ud1b5\ud574 \uc124\uba85\ud560 \uc218 \uc788\ub2e4</li> <li> \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28, \ub85c\ubd07 \uccad\uc18c\uae30 \ub4f1 \uc2e4\uc0dd\ud65c \uc0ac\ub840\ub97c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \ud504\ub808\uc784\uc73c\ub85c \ubd84\ub958\ud558\uace0 \ubd84\uc11d\ud560 \uc218 \uc788\ub2e4</li> <li> AI\uc758 \uc5ed\ud560\uacfc \uc778\uac04 \uace0\uc720\uc758 \uc5ed\ud560(\ucc3d\uc758\uc801 \uc0ac\uace0, \uacf5\uac10, \uc724\ub9ac\uc801 \ud310\ub2e8 \ub4f1)\uc744 \ube44\uad50\u00b7\ud0d0\uc0c9\ud560 \uc218 \uc788\ub2e4</li> </ul>"},{"location":"chapter01/#1","title":"\ud83e\udde0 \ud575\uc2ec \uc8fc\uc81c 1","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub780 \ubb34\uc5c7\uc778\uac00?</p> <p>\ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0, \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud558\uc5ec \ud589\ub3d9\ud558\ub294 \uc2dc\uc2a4\ud15c\uc758 \uac1c\ub150\uc744 \uc774\ud574\ud569\ub2c8\ub2e4.</p>"},{"location":"chapter01/#2","title":"\ud83e\udd1d \ud575\uc2ec \uc8fc\uc81c 2","text":"<p>\uc778\uac04\uacfc AI, \uac01\uc790\uc758 \uc5ed\ud560\uc740?</p> <p>AI\uac00 \uc798\ud558\ub294 \uc77c\uacfc \uc778\uac04\ub9cc\uc774 \ud560 \uc218 \uc788\ub294 \uc77c\uc744 \ube44\uad50\ud558\uba70 \ubbf8\ub798 \uc5ed\ud560\uc744 \ud0d0\uc0c9\ud569\ub2c8\ub2e4.</p>"},{"location":"chapter01/#50","title":"\u23f1\ufe0f \uc218\uc5c5 \ud750\ub984 (\ucd1d 50\ubd84)","text":"\ub2e8\uacc4 \ud65c\ub3d9 \uc2dc\uac04 1 \ud83d\ude80 \ub3c4\uc785 \u2014 \"\uae30\uacc4\uac00 \uc0dd\uac01\ud560 \uc218 \uc788\uc744\uae4c?\" 8\ubd84 2 \ud83d\udcda \ud575\uc2ec \uac1c\ub150 \u2014 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \uc774\ud574\ud558\uae30 12\ubd84 3 \ud83d\udd28 \ud65c\ub3d9 1 \u2014 \uc2e4\uc0dd\ud65c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \ubd84\ub958\ud558\uae30 12\ubd84 4 \ud83d\udcda \ud575\uc2ec \uac1c\ub150 \u2014 \uc778\uac04\uacfc AI\uc758 \uc5ed\ud560 \ube44\uad50 10\ubd84 5 \u2705 \ub9c8\ubb34\ub9ac \u2014 \uc131\ucc30 \ubc0f \uc815\ub9ac 8\ubd84"},{"location":"chapter01/#_2","title":"\ud83d\ude80 \ub3c4\uc785 \u2014 \"\uae30\uacc4\uac00 \uc0dd\uac01\ud560 \uc218 \uc788\uc744\uae4c?\"","text":""},{"location":"chapter01/#_3","title":"\ud83d\udcad \uc9c8\ubb38\uc73c\ub85c \uc2dc\uc791\ud569\ub2c8\ub2e4","text":"<p>\"\ub9cc\uc57d \uc5ec\ub7ec\ubd84\uc774 \ud654\uba74 \ub4a4\uc5d0 \uc788\ub294 \uc874\uc7ac\uc640 \ub300\ud654\ub97c \ub098\ub234\ub294\ub370, \uadf8\uac83\uc774 \uc0ac\ub78c\uc778\uc9c0 \uae30\uacc4\uc778\uc9c0 \uad6c\ubcc4\ud560 \uc218 \uc5c6\ub2e4\uba74 \u2014 \uadf8 \uae30\uacc4\ub294 '\uc0dd\uac01\ud55c\ub2e4'\uace0 \ub9d0\ud560 \uc218 \uc788\uc744\uae4c\uc694?\"</p> <p>\uc774 \uc9c8\ubb38\uc744 \ucc98\uc74c \ub358\uc9c4 \uc0ac\ub78c\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ubc14\ub85c \uc568\ub7f0 \ud29c\ub9c1(Alan Turing, 1912~1954)\uc774\uc5d0\uc694. \ud604\ub300 \ucef4\ud4e8\ud130 \uacfc\ud559\uc758 \uc544\ubc84\uc9c0\ub77c \ubd88\ub9ac\ub294 \uc778\ubb3c\uc774\uc8e0.</p>"},{"location":"chapter01/#_4","title":"\ud83e\uddd1\u200d\ud83d\udd2c \uc568\ub7f0 \ud29c\ub9c1\uacfc \ud29c\ub9c1 \ud14c\uc2a4\ud2b8","text":"<p>1950\ub144, \ud29c\ub9c1\uc740 \ub17c\ubb38 \"Computing Machinery and Intelligence\"\uc5d0\uc11c \ud601\uba85\uc801\uc778 \uc81c\uc548\uc744 \ud569\ub2c8\ub2e4.</p> <p>\ud29c\ub9c1 \ud14c\uc2a4\ud2b8(Turing Test): \uc0ac\ub78c\uc774 \uae30\uacc4\uc640 \ub300\ud654\ud588\uc744 \ub54c, \uc0c1\ub300\uac00 \uae30\uacc4\uc778\uc9c0 \uc0ac\ub78c\uc778\uc9c0 \uad6c\ubcc4\ud560 \uc218 \uc5c6\ub2e4\uba74 \uadf8 \uae30\uacc4\ub294 '\uc9c0\ub2a5\uc774 \uc788\ub2e4'\uace0 \ubcfc \uc218 \uc788\ub2e4.</p> <p>\uc27d\uac8c \ub9d0\ud558\uba74, \"\uc5bc\ub9c8\ub098 \uc0ac\ub78c\ucc98\ub7fc \ud589\ub3d9\ud558\ub290\ub0d0\"\ub85c \uc9c0\ub2a5\uc744 \ud310\ub2e8\ud558\uc790\ub294 \uac83\uc774\uc5c8\uc2b5\ub2c8\ub2e4.</p> sequenceDiagram     participant \uc2ec\ud310 as \ud83d\udc69 \uc2ec\ud310(\uc0ac\ub78c)     participant A as \ud83e\udd16 \uc874\uc7ac A     participant B as \ud83e\uddd1 \uc874\uc7ac B     \uc2ec\ud310-&gt;&gt;A: \uc9c8\ubb38\uc744 \ubcf4\ub0c4     A--&gt;&gt;\uc2ec\ud310: \ub300\ub2f5\uc744 \ubcf4\ub0c4     \uc2ec\ud310-&gt;&gt;B: \uac19\uc740 \uc9c8\ubb38\uc744 \ubcf4\ub0c4     B--&gt;&gt;\uc2ec\ud310: \ub300\ub2f5\uc744 \ubcf4\ub0c4     Note over \uc2ec\ud310: \ub204\uac00 \uae30\uacc4\uc774\uace0&lt;br/&gt;\ub204\uac00 \uc0ac\ub78c\uc77c\uae4c? <p>\u25b2 \ud29c\ub9c1 \ud14c\uc2a4\ud2b8\uc758 \uae30\ubcf8 \uad6c\uc870: \uc2ec\ud310\uc774 \ud14d\uc2a4\ud2b8\ub85c\ub9cc \ub300\ud654\ud558\uba70 \uc0ac\ub78c\uacfc \uae30\uacc4\ub97c \uad6c\ubcc4\ud574\uc57c \ud569\ub2c8\ub2e4</p> <p>\uc774 \uc2e4\ud5d8\uc774 \uc911\uc694\ud55c \uc774\uc720\ub294 \"\uc9c0\ub2a5\uc774\ub780 \ubb34\uc5c7\uc778\uac00?\"\ub77c\ub294 \uae4a\uc740 \ucca0\ud559\uc801 \uc9c8\ubb38\uc744 \uad00\ucc30 \uac00\ub2a5\ud55c \ud589\ub3d9\uc758 \ubb38\uc81c\ub85c \ubc14\uafb8\uc5b4\ub193\uc558\uae30 \ub54c\ubb38\uc774\uc5d0\uc694. \uadf8\ub9ac\uace0 \uc774 \uc9c8\ubb38\uc5d0\uc11c \ucd9c\ubc1c\ud55c \uac83\uc774 \ubc14\ub85c \uc624\ub298\ub0a0\uc758 \uc778\uacf5\uc9c0\ub2a5(Artificial Intelligence, AI)\uc785\ub2c8\ub2e4.</p>"},{"location":"chapter01/#_5","title":"\uc65c \uc774\uac78 \ubc30\uc6b0\ub098\uc694? \ud83e\udd14","text":"<p>\uc5ec\ub7ec\ubd84\uc740 \uc774\ubbf8 \ub9e4\uc77c AI\uc640 \ud568\uaed8 \uc0b4\uace0 \uc788\uc2b5\ub2c8\ub2e4.</p> \uc7a5\uba74 \uc228\uc5b4 \uc788\ub294 AI \uc720\ud29c\ube0c\uc5d0\uc11c \ucd94\ucc9c \uc601\uc0c1\uc774 \ub730 \ub54c \ucd94\ucc9c \uc54c\uace0\ub9ac\uc998 \uc2a4\ub9c8\ud2b8\ud3f0\uc5d0 \"\uc624\ub298 \ub0a0\uc528 \uc54c\ub824\uc918\"\ub77c\uace0 \ub9d0\ud560 \ub54c \uc74c\uc131 \uc778\uc2dd AI \ub124\ube44\uac8c\uc774\uc158\uc774 \ucd5c\uc801 \uacbd\ub85c\ub97c \uc548\ub0b4\ud560 \ub54c \uacbd\ub85c \ud0d0\uc0c9 AI \uc0ac\uc9c4 \uc571\uc774 \uce5c\uad6c \uc5bc\uad74\uc744 \uc790\ub3d9 \ud0dc\uadf8\ud560 \ub54c \uc5bc\uad74 \uc778\uc2dd AI <p>\uc774 \ubaa8\ub4e0 \uac83\uc740 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8(Intelligent Agent)\ub77c\ub294 \uacf5\ud1b5 \uc6d0\ub9ac\ub85c \uc791\ub3d9\ud569\ub2c8\ub2e4. \uc774 \uc6d0\ub9ac\ub97c \uc774\ud574\ud558\uba74, \uc0c8\ub85c\uc6b4 AI \uae30\uc220\uc744 \ub9cc\ub098\ub354\ub77c\ub3c4 \"\uc544, \uc774\uac83\ub3c4 \uacb0\uad6d \uc778\uc2dd-\ud310\ub2e8-\ud589\ub3d9\uc774\uad6c\ub098!\" \ud558\uace0 \ubcf8\uc9c8\uc744 \uaff0\ub6ab\uc5b4 \ubcfc \uc218 \uc788\uac8c \ub429\ub2c8\ub2e4.</p>"},{"location":"chapter01/#1-intelligent-agent","title":"\ud83d\udcda \ud575\uc2ec \uac1c\ub150 1: \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8(Intelligent Agent)","text":""},{"location":"chapter01/#ai","title":"\ud83c\udfaf \ube44\uc720\ub85c \uc2dc\uc791: \"AI\ub294 \ub9c8\uce58 \ub6f0\uc5b4\ub09c \uace8\ud0a4\ud37c\uc640 \uac19\uc544\uc694\"","text":"<p>\ucd95\uad6c \uace8\ud0a4\ud37c\ub97c \ub5a0\uc62c\ub824 \ubcf4\uc138\uc694.</p> <ol> <li>\ud83d\udc40 \uc778\uc2dd: \uc0c1\ub300 \uc120\uc218\uac00 \uacf5\uc744 \ucc28\ub294 \uc21c\uac04, \uacf5\uc758 \ubc29\ud5a5\u00b7\uc18d\ub3c4\u00b7\ud68c\uc804\uc744 \ub208\uc73c\ub85c \ud30c\uc545\ud569\ub2c8\ub2e4</li> <li>\ud83e\udde0 \ud310\ub2e8: \uba38\ub9bf\uc18d\uc5d0\uc11c \"\uc67c\ucabd \uc0c1\ub2e8\uc73c\ub85c \ub0a0\uc544\uc628\ub2e4!\"\uace0 \uc21c\uc2dd\uac04\uc5d0 \uacc4\uc0b0\ud569\ub2c8\ub2e4</li> <li>\ud83c\udfc3 \ud589\ub3d9: \ubab8\uc744 \uc67c\ucabd\uc73c\ub85c \ub0a0\ub824 \uacf5\uc744 \ub9c9\uc2b5\ub2c8\ub2e4</li> </ol> <p>\uace8\ud0a4\ud37c\uac00 \uc774 3\ub2e8\uacc4\ub97c \ubc18\ubcf5\ud558\uba74\uc11c \uacbd\uae30 \ub0b4\ub0b4 \uace8\ubb38\uc744 \uc9c0\ud0a4\ub4ef, \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub3c4 \ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0, \ud310\ub2e8\ud558\uace0, \ud589\ub3d9\ud558\ub294 \uacfc\uc815\uc744 \ub04a\uc784\uc5c6\uc774 \ubc18\ubcf5\ud569\ub2c8\ub2e4.</p>"},{"location":"chapter01/#_6","title":"\ud83d\udcd6 \uc815\ud655\ud55c \uc815\uc758","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8(Intelligent Agent)\ub780, \uc13c\uc11c(sensor)\ub97c \ud1b5\ud574 \uc8fc\ubcc0 \ud658\uacbd\uc744 \uc778\uc2dd\ud558\uace0, \ub0b4\ubd80 \uaddc\uce59\uc774\ub098 \ud559\uc2b5\ub41c \ubaa8\ub378\uc744 \ubc14\ud0d5\uc73c\ub85c \ud310\ub2e8\uc744 \ub0b4\ub9b0 \ud6c4, \uc561\ucd94\uc5d0\uc774\ud130(actuator, \uc2e4\ud589 \uc7a5\uce58)\ub97c \ud1b5\ud574 \ud658\uacbd\uc5d0 \ud589\ub3d9\ud558\ub294 \uc2dc\uc2a4\ud15c\uc744 \ub9d0\ud569\ub2c8\ub2e4.</p> <p>\uc5ec\uae30\uc11c \ud575\uc2ec \ub2e8\uc5b4\ub97c \ud558\ub098\uc529 \uc9da\uc5b4\ubcfc\uac8c\uc694.</p> \uc6a9\uc5b4 \uc26c\uc6b4 \uc124\uba85 \uace8\ud0a4\ud37c \ube44\uc720 AI \uc608\uc2dc \uc13c\uc11c(Sensor) \ud658\uacbd \uc815\ubcf4\ub97c \uc218\uc9d1\ud558\ub294 \uc785\ub825 \uc7a5\uce58 \ub208, \uadc0 \uce74\uba54\ub77c, \ub9c8\uc774\ud06c, GPS \ud310\ub2e8(Decision) \uc218\uc9d1\ub41c \uc815\ubcf4\ub97c \ubd84\uc11d\ud558\uc5ec \ub2e4\uc74c \ud589\ub3d9\uc744 \uacb0\uc815 \ub450\ub1cc\uc758 \uc21c\uac04 \uacc4\uc0b0 \uc54c\uace0\ub9ac\uc998, AI \ubaa8\ub378 \uc561\ucd94\uc5d0\uc774\ud130(Actuator) \uacb0\uc815\uc744 \uc2e4\ud589\ud558\ub294 \ucd9c\ub825 \uc7a5\uce58 \ud314, \ub2e4\ub9ac \ubaa8\ud130, \uc2a4\ud53c\ucee4, \ud654\uba74 \ud45c\uc2dc"},{"location":"chapter01/#_7","title":"\ud83d\udd04 \uc778\uc2dd \u2192 \ud310\ub2e8 \u2192 \ud589\ub3d9\uc758 \uc21c\ud658","text":"<p>\uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uc791\ub3d9 \uc6d0\ub9ac\ub97c \ub2e4\uc774\uc5b4\uadf8\ub7a8\uc73c\ub85c \uc0b4\ud3b4\ubd05\uc2dc\ub2e4.</p> \ud83c\udf0d \ud658\uacbd (Environment) \ud83d\udc40 \uc778\uc2dd (\uc13c\uc11c\ub85c \uc815\ubcf4 \uc218\uc9d1) \ud83e\udde0 \ud310\ub2e8 (\ubd84\uc11d \ud6c4 \uacb0\uc815) \ud83c\udfc3 \ud589\ub3d9 (\ud658\uacbd\uc5d0 \ubcc0\ud654\ub97c \uc90c) \ud83d\udd04 \ud53c\ub4dc\ubc31 (\ud658\uacbd \ubcc0\ud654\ub97c \ub2e4\uc2dc \uc778\uc2dd) <p>\u25b2 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \ud575\uc2ec \uc791\ub3d9 \uc6d0\ub9ac: \uc778\uc2dd \u2192 \ud310\ub2e8 \u2192 \ud589\ub3d9\uc758 \ub04a\uc784\uc5c6\ub294 \uc21c\ud658</p> <p>\uc911\uc694\ud55c \uc810\uc740 \uc774 \uacfc\uc815\uc774 \ud55c \ubc88\uc73c\ub85c \ub05d\ub098\uc9c0 \uc54a\ub294\ub2e4\ub294 \uac83\uc785\ub2c8\ub2e4. \ud589\ub3d9\uc758 \uacb0\uacfc\ub85c \ud658\uacbd\uc774 \ubcc0\ud558\uba74, \ubcc0\ud55c \ud658\uacbd\uc744 \ub2e4\uc2dc \uc778\uc2dd\ud558\uace0, \ub2e4\uc2dc \ud310\ub2e8\ud558\uace0, \ub2e4\uc2dc \ud589\ub3d9\ud569\ub2c8\ub2e4. \uc774 \uc21c\ud658\uc774 \ubc14\ub85c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \ud575\uc2ec\uc774\uc5d0\uc694!</p>"},{"location":"chapter01/#1_1","title":"\ud83d\ude97 \uc608\uc2dc\ub85c \ud655\uc778 1: \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28","text":"<p>\uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\ub97c \uc778\uc2dd-\ud310\ub2e8-\ud589\ub3d9 \ud504\ub808\uc784\uc73c\ub85c \ubd84\uc11d\ud574 \ubd05\uc2dc\ub2e4.</p> \ub2e8\uacc4 \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\uac00 \ud558\ub294 \uc77c \uc0ac\uc6a9 \uae30\uc220 \ud83d\udc40 \uc778\uc2dd \uce74\uba54\ub77c\ub85c \ucc28\uc120\u00b7\uc2e0\ud638\ub4f1\u00b7\ubcf4\ud589\uc790\ub97c \uac10\uc9c0\ud558\uace0, \ub77c\uc774\ub2e4(LiDAR)\ub85c \uc8fc\ubcc0 \ubb3c\uccb4\uc640\uc758 \uac70\ub9ac\ub97c \uce21\uc815 \uce74\uba54\ub77c, \ub77c\uc774\ub2e4, \ub808\uc774\ub354, GPS \ud83e\udde0 \ud310\ub2e8 \"\uc804\ubc29 30m\uc5d0 \ubcf4\ud589\uc790\uac00 \ud6a1\ub2e8\ubcf4\ub3c4\ub97c \uac74\ub108\uace0 \uc788\uc73c\ub2c8 \uc815\uc9c0\ud574\uc57c \ud55c\ub2e4\" \ub525\ub7ec\ub2dd \ubaa8\ub378, \uacbd\ub85c \uacc4\ud68d \uc54c\uace0\ub9ac\uc998 \ud83c\udfc3 \ud589\ub3d9 \ube0c\ub808\uc774\ud06c\ub97c \ubc1f\uc544 \uc18d\ub3c4\ub97c \uc904\uc774\uace0 \uc815\uc9c0\uc120\uc5d0\uc11c \uba48\ucda4 \ubaa8\ud130 \uc81c\uc5b4, \ube0c\ub808\uc774\ud06c \uc2dc\uc2a4\ud15c <p>\uadf8\ub9ac\uace0 \ubcf4\ud589\uc790\uac00 \ub2e4 \uac74\ub10c \ud6c4, \ub2e4\uc2dc \uc778\uc2dd(\ubcf4\ud589\uc790\uac00 \uc0ac\ub77c\uc9d0) \u2192 \ud310\ub2e8(\ucd9c\ubc1c\ud574\ub3c4 \uc548\uc804\ud568) \u2192 \ud589\ub3d9(\uac00\uc18d\ud558\uc5ec \ucd9c\ubc1c)\uc758 \uc21c\ud658\uc774 \uc774\uc5b4\uc9d1\ub2c8\ub2e4.</p>"},{"location":"chapter01/#2_1","title":"\ud83e\uddf9 \uc608\uc2dc\ub85c \ud655\uc778 2: \ub85c\ubd07 \uccad\uc18c\uae30","text":"flowchart LR     A[\"\ud83d\udc40 \uc778\uc2dd&lt;br/&gt;\uc801\uc678\uc120 \uc13c\uc11c\ub85c&lt;br/&gt;\uc7a5\uc560\ubb3c \uac10\uc9c0\"] --&gt; B[\"\ud83e\udde0 \ud310\ub2e8&lt;br/&gt;\uc7a5\uc560\ubb3c\uc744 \ud53c\ud574&lt;br/&gt;\uacbd\ub85c \uc7ac\uc124\uc815\"]     B --&gt; C[\"\ud83c\udfc3 \ud589\ub3d9&lt;br/&gt;\ubc29\ud5a5\uc744 \ud2c0\uc5b4&lt;br/&gt;\uccad\uc18c \uacc4\uc18d\"]     C --&gt;|\ud658\uacbd \ubcc0\ud654| A <p>\u25b2 \ub85c\ubd07 \uccad\uc18c\uae30\uc758 \uc778\uc2dd-\ud310\ub2e8-\ud589\ub3d9 \uc21c\ud658</p> \ub2e8\uacc4 \ub85c\ubd07 \uccad\uc18c\uae30\uac00 \ud558\ub294 \uc77c \ud83d\udc40 \uc778\uc2dd \uc801\uc678\uc120 \uc13c\uc11c\u00b7\ubc94\ud37c \uc13c\uc11c\ub85c \ubcbd, \uac00\uad6c, \uc808\ubcbd(\uacc4\ub2e8) \uac10\uc9c0. \uba3c\uc9c0 \uc13c\uc11c\ub85c \ubc14\ub2e5 \uc624\uc5fc\ub3c4 \uce21\uc815 \ud83e\udde0 \ud310\ub2e8 \"\uc67c\ucabd\uc5d0 \ubcbd\uc774 \uc788\uc73c\ub2c8 \uc624\ub978\ucabd\uc73c\ub85c \ub3cc\uc790\", \"\uc774 \uad6c\uc5ed\uc740 \uba3c\uc9c0\uac00 \ub9ce\uc73c\ub2c8 \uc9d1\uc911 \uccad\uc18c\ud558\uc790\" \ud83c\udfc3 \ud589\ub3d9 \ubc14\ud034\ub97c \ud68c\uc804\uc2dc\ucf1c \uc774\ub3d9, \ube0c\ub7ec\uc2dc\uc640 \ud761\uc785 \ubaa8\ud130\ub85c \uba3c\uc9c0\ub97c \uc81c\uac70 <p>\ud83d\udca1 \uae68\ub2ec\uc74c \ud3ec\uc778\ud2b8: \uc790\uc728\uc8fc\ud589 \uc790\ub3d9\ucc28\uc640 \ub85c\ubd07 \uccad\uc18c\uae30\ub294 \ubcf5\uc7a1\ub3c4\uac00 \ub9e4\uc6b0 \ub2e4\ub974\uc9c0\ub9cc, \uc778\uc2dd \u2192 \ud310\ub2e8 \u2192 \ud589\ub3d9\uc774\ub77c\ub294 \ubf08\ub300 \uad6c\uc870\ub294 \ub3d9\uc77c\ud569\ub2c8\ub2e4. \uc774\uac83\uc774 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \ud504\ub808\uc784\uc6cc\ud06c\uc758 \ud798\uc774\uc5d0\uc694!</p>"},{"location":"chapter01/#_8","title":"\ud83d\udcca \uc5d0\uc774\uc804\ud2b8\uc758 \uc720\ud615: \ub2e8\uc21c\uc5d0\uc11c \ubcf5\uc7a1\uae4c\uc9c0","text":"<p>\ubaa8\ub4e0 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uac00 \uac19\uc740 \uc218\uc900\uc740 \uc544\ub2d9\ub2c8\ub2e4. \ud310\ub2e8\uc758 \ubcf5\uc7a1\ub3c4\uc5d0 \ub530\ub77c \uc720\ud615\uc774 \ub098\ub258\uc5b4\uc694.</p> \uc720\ud615 \uc124\uba85 \uc608\uc2dc \ub2e8\uc21c \ubc18\uc0ac \uc5d0\uc774\uc804\ud2b8 \"\uc774\ub7f0 \uc0c1\ud669\uc774\uba74 \u2192 \uc774\ub807\uac8c \ud589\ub3d9\" \uaddc\uce59\ub9cc \ub530\ub984 \uc790\ub3d9\ubb38 (\uc0ac\ub78c \uac10\uc9c0 \u2192 \uc5f4\ub9bc) \ubaa8\ub378 \uae30\ubc18 \uc5d0\uc774\uc804\ud2b8 \ud658\uacbd\uc758 \uc0c1\ud0dc\ub97c \uae30\uc5b5\ud558\uba70 \ud310\ub2e8 \ub85c\ubd07 \uccad\uc18c\uae30 (\uccad\uc18c\ud55c \uacf3 \uae30\uc5b5) \ubaa9\ud45c \uae30\ubc18 \uc5d0\uc774\uc804\ud2b8 \ubaa9\ud45c \ub2ec\uc131\uc744 \uc704\ud574 \uc5ec\ub7ec \ud589\ub3d9\uc744 \uacc4\ud68d \ub0b4\ube44\uac8c\uc774\uc158 (\ucd5c\ub2e8 \uacbd\ub85c \ud0d0\uc0c9) \ud559\uc2b5 \uc5d0\uc774\uc804\ud2b8 \uacbd\ud5d8\uc73c\ub85c\ubd80\ud130 \uc2a4\uc2a4\ub85c \ud559\uc2b5\ud558\uc5ec \uc131\ub2a5 \ud5a5\uc0c1 \ucd94\ucc9c \uc2dc\uc2a4\ud15c (\uc0ac\uc6a9\uc790 \ucde8\ud5a5 \ud559\uc2b5) graph LR     A[\"\ub2e8\uc21c \ubc18\uc0ac&lt;br/&gt;\uc5d0\uc774\uc804\ud2b8\"] --&gt; B[\"\ubaa8\ub378 \uae30\ubc18&lt;br/&gt;\uc5d0\uc774\uc804\ud2b8\"]     B --&gt; C[\"\ubaa9\ud45c \uae30\ubc18&lt;br/&gt;\uc5d0\uc774\uc804\ud2b8\"]     C --&gt; D[\"\ud559\uc2b5&lt;br/&gt;\uc5d0\uc774\uc804\ud2b8\"]     style A fill:#E3F2FD,stroke:#2196F3     style B fill:#E8F5E9,stroke:#4CAF50     style C fill:#FFF3E0,stroke:#FF9800     style D fill:#FCE4EC,stroke:#F44336 <p>\u25b2 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\uc758 \uc720\ud615: \uc67c\ucabd\uc5d0\uc11c \uc624\ub978\ucabd\uc73c\ub85c \uac08\uc218\ub85d \ud310\ub2e8 \ub2a5\ub825\uc774 \ubcf5\uc7a1\ud574\uc9d1\ub2c8\ub2e4</p>"},{"location":"chapter01/#1_2","title":"\ud83d\udd28 \ud65c\ub3d9 1: \uc2e4\uc0dd\ud65c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \ubd84\ub958\ud558\uae30","text":""},{"location":"chapter01/#_9","title":"\ud83d\udccb \ud65c\ub3d9 \uc548\ub0b4","text":"<p>\uc774\uc81c \uc5ec\ub7ec\ubd84\uc774 \uc9c1\uc811 \ubd84\uc11d\ud560 \ucc28\ub840\uc785\ub2c8\ub2e4! \uc544\ub798 5\uac00\uc9c0 \uc2e4\uc0dd\ud65c AI \uc0ac\ub840\ub97c \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \ubd84\uc11d\ud45c\uc5d0 \uc815\ub9ac\ud574 \ubcf4\uc138\uc694.</p>"},{"location":"chapter01/#step-1","title":"Step 1: \ubd84\uc11d \ub300\uc0c1 \ud655\uc778\ud558\uae30","text":"<p>\ub2e4\uc74c 5\uac00\uc9c0 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8\ub97c \uc0b4\ud3b4\ubd05\uc2dc\ub2e4.</p> \ubc88\ud638 \uc9c0\ub2a5 \uc5d0\uc774\uc804\ud2b8 \uac04\ub2e8 \uc124\uba85 \u2460 \ud83c\udfe5 \uc758\ub8cc \uc9c4\ub2e8 AI \ud658\uc790\uc758 X-ray, CT \uc601\uc0c1\uc744 \ubd84\uc11d\ud558\uc5ec \uc9c8\ubcd1\uc744 \uc9c4\ub2e8\ud558\ub294 \uc2dc\uc2a4\ud15c \u2461 \ud83d\udcf1 \ub300\ud654\ud615 \uc601\uc5b4 \ud559\uc2b5 \uc571 \ud559\uc2b5\uc790\uc640 \uc601\uc5b4\ub85c \ub300\ud654\ud558\uba70 \ubb38\ubc95\u00b7\ubc1c\uc74c\uc744 \uad50\uc815\ud574\uc8fc\ub294 AI \u2462 \ud83c\udfed \uc2a4\ub9c8\ud2b8 \uacf5\uc7a5 \ub85c\ubd07 \uc81c\ud488 \ubd88\ub7c9\uc744 \uac10\uc9c0\ud558\uace0 \ubd88\ub7c9\ud488\uc744 \uc790\ub3d9\uc73c\ub85c \uace8\ub77c\ub0b4\ub294 \ub85c\ubd07 \u2463 \ud83c\udfb5 \uc74c\uc545 \ucd94\ucc9c AI \uc0ac\uc6a9\uc790\uc758 \uccad\ucde8 \uae30\ub85d\uc744 \ubd84\uc11d\ud558\uc5ec \uc88b\uc544\ud560 \ub9cc\ud55c \ub178\ub798\ub97c \ucd94\ucc9c \u2464 \ud83c\udf3e \uc790\uc728\uc8fc\ud589 \ub18d\uc5c5 \ud2b8\ub799\ud130 GPS\uc640 \uc13c\uc11c\ub85c \ub18d\uacbd\uc9c0\ub97c \uc790\uc728 \uc8fc\ud589\ud558\uba70 \uc528\uc557\uc744 \ubfcc\ub9ac\ub294 \ud2b8\ub799\ud130"},{"location":"chapter01/#step-2","title":"Step 2: \ubd84\uc11d\ud45c \ucc44\uc6b0\uae30","text":"<p>\uc544\ub798 \ud45c\uc758 \ube48\uce78\uc744 \ucc44\uc6cc \ubcf4\uc138\uc694. \u2460\ubc88\uc740 \uc608\uc2dc\ub85c \uc791\uc131\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.</p> \ud56d\ubaa9 \u2460 \uc758\ub8cc \uc9c4\ub2e8 AI \u2461 \uc601\uc5b4 \ud559\uc2b5 \uc571 \u2462 \uc2a4\ub9c8\ud2b8 \uacf5\uc7a5 \ub85c\ubd07 \u2463 \uc74c\uc545 \ucd94\ucc9c AI \u2464 \uc790\uc728\uc8fc\ud589 \ud2b8\ub799\ud130 \ud83c\udfaf \ubaa9\ud45c \uc815\ud655\ud55c \uc9c8\ubcd1 \uc9c4\ub2e8 _____ _____ _____ _____ \ud83c\udf0d \ud658\uacbd \ubcd1\uc6d0 \uc9c4\ub2e8\uc2e4 _____ _____ _____ _____ \ud83d\udc40 \uc778\uc2dd (\uc13c\uc11c) X-ray/CT \uc601\uc0c1 \ub370\uc774\ud130 _____ _____ _____ _____ \ud83e\udde0 \ud310\ub2e8 \uc601\uc0c1 \ud328\ud134\uc744 \ubd84\uc11d\ud558\uc5ec \uc774\uc0c1 \ubd80\uc704 \uc2dd\ubcc4 _____ _____ _____ _____ \ud83c\udfc3 \ud589\ub3d9 (\ucd9c\ub825) \uc9c4\ub2e8 \uacb0\uacfc\uc640 \uc774\uc0c1 \ubd80\uc704\ub97c \uc758\uc0ac\uc5d0\uac8c \ud45c\uc2dc _____ _____ _____ _____ \ud83d\udcc2 \uc5d0\uc774\uc804\ud2b8 \uc720\ud615 \ud559\uc2b5 \uc5d0\uc774\uc804\ud2b8 _____ _____ _____ _____"},{"location":"chapter01/#step-3","title":"Step 3: \uc791\uc131\ud55c \ub0b4\uc6a9 \uc810\uac80\ud558\uae30","text":"<p>\ub2e4 \uc791\uc131\ud588\ub098\uc694? \uc544\ub798\uc5d0\uc11c \ubaa8\ubc94 \ub2f5\uc548\uc744 \ud655\uc778\ud574 \ubd05\uc2dc\ub2e4.</p> \ud83d\udcdd \ubaa8\ubc94 \ub2f5\uc548 \ud655\uc778\ud558\uae30 (\ud074\ub9ad)  | \ud56d\ubaa9 | \u2461 \uc601\uc5b4 \ud559\uc2b5 \uc571 | \u2462 \uc2a4\ub9c8\ud2b8 \uacf5\uc7a5 \ub85c\ubd07 | \u2463 \uc74c\uc545 \ucd94\ucc9c AI | \u2464 \uc790\uc728\uc8fc\ud589 \ud2b8\ub799\ud130 | |:---|:---|:---|:---|:---| | **\ud83c\udfaf \ubaa9\ud45c** | \ud559\uc2b5\uc790\uc758 \uc601\uc5b4 \uc2e4\ub825 \ud5a5\uc0c1 | \ubd88\ub7c9\ud488 \uc81c\uac70, \ud488\uc9c8 \uc720\uc9c0 | \uc0ac\uc6a9\uc790 \ub9cc\uc871\ub3c4 \ub192\uc740 \uc74c\uc545 \ucd94\ucc9c | \uc815\ud655\ud55c \uc704\uce58\uc5d0 \uc528\uc557 \ud30c\uc885 | | **\ud83c\udf0d \ud658\uacbd** | \uc2a4\ub9c8\ud2b8\ud3f0/\ud0dc\ube14\ub9bf \uc571 | \uacf5\uc7a5 \uc0dd\uc0b0 \ub77c\uc778 | \uc74c\uc545 \uc2a4\ud2b8\ub9ac\ubc0d \ud50c\ub7ab\ud3fc | \ub18d\uacbd\uc9c0 | | **\ud83d\udc40 \uc778\uc2dd** | \ub9c8\uc774\ud06c\ub85c \uc74c\uc131 \uc785\ub825, \ud14d\uc2a4\ud2b8 \uc785\ub825 | \uce74\uba54\ub77c\ub85c \uc81c\ud488 \uc678\uad00 \ucd2c\uc601 | \uc0ac\uc6a9\uc790 \uccad\ucde8 \uae30\ub85d, \uc88b\uc544\uc694/\uc2a4\ud0b5 \ub370\uc774\ud130 | GPS \uc704\uce58, \uce74\uba54\ub77c\u00b7\ud1a0\uc591 \uc13c\uc11c | | **\ud83e\udde0 \ud310\ub2e8** | \ubb38\ubc95 \uc624\ub958\u00b7\ubc1c\uc74c \uc815\ud655\ub3c4 \ubd84\uc11d, \uc218\uc900\ubcc4 \ub300\ud654 \uc0dd\uc131 | \uc815\uc0c1/\ubd88\ub7c9 \ud310\ubcc4 (\ud328\ud134 \ube44\uad50) | \ucde8\ud5a5 \ud328\ud134 \ubd84\uc11d, \uc720\uc0ac \uc0ac\uc6a9\uc790 \ube44\uad50 | \uc8fc\ud589 \uacbd\ub85c \uacc4\ud68d, \ud30c\uc885 \uc704\uce58\u00b7\uac04\uaca9 \uacb0\uc815 | | **\ud83c\udfc3 \ud589\ub3d9** | \uad50\uc815 \ud53c\ub4dc\ubc31 \uc81c\uacf5, \ub2e4\uc74c \ub300\ud654 \uc8fc\uc81c \uc81c\uc2dc | \ubd88\ub7c9\ud488\uc744 \ub77c\uc778\uc5d0\uc11c \uc81c\uac70 | \ub9de\ucda4\ud615 \ud50c\ub808\uc774\ub9ac\uc2a4\ud2b8 \uc0dd\uc131 | \ud578\ub4e4 \uc870\uc791, \ud30c\uc885\uae30 \uc791\ub3d9 | | **\ud83d\udcc2 \uc720\ud615** | \ud559\uc2b5 \uc5d0\uc774\uc804\ud2b8 | \ubaa8\ub378 \uae30\ubc18 / \ud559\uc2b5 \uc5d0\uc774\uc804\ud2b8 | \ud559\uc2b5 \uc5d0\uc774\uc804\ud2b8 | \ubaa9\ud45c \uae30\ubc18 / \ud559\uc2b5 \uc5d0\uc774\uc804\ud2b8 |"},{"location":"chapter01/#step-4","title":"Step 4: \uc0dd\uac01 \ub098\ub204\uae30 \ud83d\udcac","text":"<p>\ub2e4\uc74c \uc9c8\ubb38\uc5d0 \ub300\ud574 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694 (\ub178\ud2b8\uc5d0 \uac04\ub2e8\ud788 \uc801\uc5b4\ubd10\ub3c4 \uc88b\uc544\uc694).</p> <p>\"\uc704 5\uac00\uc9c0 \uc5d0\uc774\uc804\ud2b8 \uc911, \uac00\uc7a5 \ubcf5\uc7a1\ud55c \ud310\ub2e8\uc744 \ub0b4\ub824\uc57c \ud558\ub294 \uac83\uc740 \ubb34\uc5c7\uc774\uace0, \uc65c \uadf8\ub807\uac8c \uc0dd\uac01\ud558\ub098\uc694?\"</p> \ud83d\udca1 \uc0dd\uac01\uc758 \ud78c\ud2b8  \ubcf5\uc7a1\ud55c \ud310\ub2e8\uc758 \uae30\uc900\uc744 \uc0dd\uac01\ud574 \ubcf4\uc138\uc694: - \uc2e4\uc2dc\uac04\uc73c\ub85c \ube60\ub974\uac8c \ud310\ub2e8\ud574\uc57c \ud558\ub294\uac00? - \ud310\ub2e8 \uc2e4\uc218"}]}